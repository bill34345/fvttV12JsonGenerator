{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "foundry-modules/**/*.ts",
    "foundry-modules/**/*.tsx"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "packages/**/__tests__/**",
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx",
    "packages/**/*.spec.ts",
    "packages/**/*.spec.tsx",
    "apps/**/__tests__/**",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "apps/**/*.spec.ts",
    "apps/**/*.spec.tsx",
    "foundry-modules/**/__tests__/**",
    "foundry-modules/**/*.test.ts",
    "foundry-modules/**/*.test.tsx",
    "foundry-modules/**/*.spec.ts",
    "foundry-modules/**/*.spec.tsx",
    "src/temp/**"
  ]
}
