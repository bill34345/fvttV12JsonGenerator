{
  "goal": "只补导出缺失字段，复用独立有效的行为证据",
  "acceptance": ["只执行声明的导出检查", "复用/本轮不做项不进入命令覆盖范围"],
  "caseId": "bounded-export-repair",
  "workspaceRoot": "<实际Git工作树绝对路径>",
  "candidatePaths": ["<本轮导出检查源码绝对路径>"],
  "authority": { "source": "<当前文件检查授权引用>", "scope": "local-file-checks" },
  "preflight": [
    { "id": "syntax", "argv": ["<node.exe绝对路径>", "--check", "<本轮导出检查源码绝对路径>"], "timeoutMs": 10000, "validationCases": [] }
  ],
  "operation": {
    "id": "export-only", "argv": ["<node.exe绝对路径>", "<只检查导出的入口绝对路径>"], "timeoutMs": 30000,
    "validationCases": [{ "id": "export", "layer": "evidence" }]
  },
  "adapter": "json-ok",
  "validationSelection": {
    "cases": [
      {
        "id": "drawing", "layer": "behavior", "decision": "reuse", "reason": "相关行为代码及目标未变；导出故障不影响已接受的直接行为证据。",
        "context": { "target": "<目标及相关客户端>", "interface": "<相关接口版本>", "sourceSha256": "<已核对的相关源码指纹>" },
        "previous": { "absolutePath": "<旧行为分项绑定记录绝对路径>", "sha256": "<该记录实际SHA-256>" }
      },
      {
        "id": "export", "layer": "evidence", "decision": "check", "reason": "只补导出缺失数值的往返证明。",
        "context": { "format": "v2" },
        "previous": { "absolutePath": "<旧导出分项绑定记录绝对路径>", "sha256": "<该记录实际SHA-256>" },
        "invalidation": { "kind": "tool-repair", "reason": "旧导出数值变成文本，原行为结论仍独立有效。", "evidence": { "absolutePath": "<本次具体诊断或差异记录绝对路径>", "sha256": "<该记录实际SHA-256>" } }
      },
      {
        "id": "drawing", "layer": "restoration", "decision": "defer", "reason": "本轮只做文件检查，未证明的现场恢复不称完成。", "context": { "target": "not-this-file-batch" }
      }
    ]
  }
}
