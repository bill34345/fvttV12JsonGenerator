{
  "template": true,
  "protocolVersion": 1,
  "usage": "仅复杂任务或跨聊天接手需要结构化当前状态时使用；小修改保留简短说明。此文件是任务当前状态，唯一owner维护；每次运行合同仍使用development-feedback-request.example.json。inspect-state只核对task/workspace/candidates/authority/case/result.reportStatus/resume/integration及其引用，不执行runtime/fixture/callback。机器字段从现有合同或Git/文件读取；template:true的示例会被拒绝。",
  "task": {
    "id": "<task-id>",
    "ownerThreadId": "<project-executor-uuid>",
    "reviewerThreadId": "<authorized-reviewer-uuid>",
    "goal": "<可观察行为>",
    "acceptance": [
      "<成功例>",
      "<关键反例>"
    ],
    "nonGoals": [
      "<保留的边界>"
    ],
    "intentDecisions": [],
    "userQuestions": []
  },
  "workspace": {
    "absoluteRoot": "<verified-absolute-worktree>",
    "branch": "<branch>",
    "head": "<sha>",
    "instructionBaseline": "<committed-policy-version>"
  },
  "candidates": [
    { "absolutePath": "<candidate-file>", "sha256": "<read-from-file-or-existing-contract>" }
  ],
  "research": {
    "needed": true,
    "sources": [
      {
        "url": "<source>",
        "versionOrCommit": "<fixed-version>",
        "license": "<license>",
        "relevantFact": "<interface-fact>",
        "probe": "<evidence-or-command>",
        "adoption": "<adapt-or-reject-reason>"
      }
    ],
    "unresolvedHypotheses": []
  },
  "runtime": {
    "profile": "<server-mirror-or-server-next>",
    "world": "<world>",
    "foundry": "<exact-version>",
    "system": "<exact-version>",
    "owner": "<verified-service-owner>",
    "buildOrInstallIdentity": "<fingerprint>",
    "baselineRef": "<evidence-file>"
  },
  "execution": {
    "contractRevision": 1,
    "parentThreadId": "<uuid>",
    "executorThreadId": "<uuid-or-null>",
    "model": "<explicit-user-choice-or-effective-default>",
    "reasoningEffort": "<effective>",
    "transport": "<authorized-tool-surface>",
    "dispatchId": "<unique>",
    "contractAbsolutePath": "<absolute-path>",
    "parentPreflightEvidence": null,
    "executorPreflightEvidence": null
  },
  "authority": {
    "userInstructionRef": "<message-reference>",
    "allowed": [
      "<exact-scope>"
    ],
    "prohibited": [
      "<scope>"
    ]
  },
  "case": {
    "id": "<case>",
    "phase": "NOT_STARTED",
    "fixtureRef": "<run-owned-resources>",
    "preflightEvidence": null,
    "latestReceiptId": null,
    "lastFailure": null,
    "retriesWithoutNewEvidence": 0
  },
  "result": {
    "reportStatus": "NOT_REPORTED",
    "receiptId": null,
    "contractRevision": null,
    "behavior": "NOT_EXECUTED",
    "evidence": "MISSING",
    "cleanup": "NOT_EXECUTED",
    "summaryPath": null,
    "rawEvidencePath": null,
    "rawSha256": null
  },
  "resume": {
    "nextAction": "<single-current-action>",
    "supersedes": [],
    "decision": null,
    "callback": {
      "sendReceiptRef": null,
      "recipientThreadId": null,
      "parentReceivedEvidenceRef": null,
      "parentAcceptedEvidenceRef": null
    }
  },
  "integration": { "status": "NOT_INTEGRATED", "target": null }
}
