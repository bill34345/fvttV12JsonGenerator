{
  "name": "fvttv12jsongenerator",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test --max-concurrency 4",
    "typecheck:production": "tsc -p tsconfig.production.json --pretty false",
    "typecheck:all": "tsc -p tsconfig.json --pretty false",
    "typecheck:packages": "tsc -p packages/contracts/tsconfig.json --pretty false && tsc -p packages/parser/tsconfig.json --pretty false",
    "architecture:deps": "bunx --bun depcruise --config .dependency-cruiser.cjs -- src packages scripts tests",
    "architecture:cycles": "bun node_modules/knip/bin/knip-bun.js --cycles --no-config-hints",
    "architecture:unused": "bun node_modules/knip/bin/knip-bun.js --no-exit-code --no-config-hints --reporter compact",
    "architecture:verify": "bun run architecture:deps && bun run architecture:cycles",
    "coverage:verify": "bun run src/tools/coverageGate.ts coverage/lcov.info",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage --max-concurrency 4 && bun run coverage:verify",
    "smoke:actor:offline": "bun run src/tools/ciActorSmoke.ts",
    "hygiene:repository": "bun run src/tools/repositoryHygiene.ts",
    "ci:verify": "bun run typecheck:production && bun run typecheck:all && bun run typecheck:packages && bun run architecture:verify && bun run test:coverage && bun run audit:anti-overfit:all && bun run hygiene:repository && bun run references verify dnd5e-5.3.3 && bun run web:build && bun run smoke:actor:offline",
    "test:npc": "bun test tests/acceptance/alyxian-aboleth.acceptance.test.ts tests/acceptance/scuttling-serpentmaw.acceptance.test.ts tests/acceptance/slithering-bloodfin.acceptance.test.ts tests/e2e.test.ts src/core/generator/__tests__/phase1-validation.test.ts",
    "sync:vault": "bun run src/index.ts --sync --vault \"obsidian/dnd数据转fvttjson\"",
    "translate:pending": "bun run src/index.ts --translate-json --translate-dir \"data/need_tran\"",
    "cli:help": "bun run src/index.ts --help",
    "web:api": "bun run src/web/server/index.ts",
    "web:dev": "bun run src/web/dev.ts",
    "web:build": "vite build",
    "web:start": "bun run src/web/server/index.ts",
    "verify:actor": "bun run src/tools/actorVerification.ts",
    "verify:intake": "bun run src/tools/intakeVerification.ts",
    "audit:anti-overfit": "bun run src/tools/antiOverfitAudit.ts",
    "audit:world-footprint": "bun run src/tools/worldFootprintAudit.ts --world-root \".local/foundry-v14/data/server-mirror/Data/worlds/cor-cotn\" --app-root \".local/foundry-v14/app/14.364\" --output-dir \".local/foundry-v14/evidence/cor-cotn-world-audit-20260724\" --snapshot-dir \".local/foundry-v14/evidence/cor-cotn-world-audit-20260724/snapshot\"",
    "audit:anti-overfit:all": "bun run src/tools/antiOverfitAudit.ts --all",
    "foundry:lab": "bun run scripts/foundry-lab/cli.ts",
    "test:foundry-lab": "bun test scripts/foundry-lab/__tests__",
    "build:spell-resolver": "bun run scripts/buildSpellResolver.ts",
    "test:spell-resolver": "bun test src/core/spell-resolution src/foundry/monster-spell-resolver",
    "build:chat-memory-guard": "bun run scripts/buildChatMemoryGuard.ts",
    "install:chat-memory-guard": "bun run scripts/buildChatMemoryGuard.ts --install",
    "test:chat-memory-guard": "bun test src/foundry/chat-memory-guard --max-concurrency 4",
    "build:session-monitor": "bun run scripts/buildSessionMonitor.ts",
    "install:session-monitor": "bun run scripts/buildSessionMonitor.ts --install",
    "test:session-monitor": "bun test src/foundry/session-monitor scripts/session-monitor --max-concurrency 4",
    "monitor:session": "bun run scripts/session-monitor/cli.ts",
    "build:icon-catalog:v14": "bun run scripts/buildV14IconCatalog.ts",
    "review:icons:v14": "bun run src/tools/iconReviewGallery.ts",
    "references": "bun run src/tools/referenceCache.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.29.0",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fvtt-json-generator/contracts": "workspace:*",
    "@fvtt-json-generator/parser": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "cheerio": "^1.2.0",
    "commander": "^14.0.2",
    "crawlee": "^3.17.0",
    "domhandler": "^6.0.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.2"
  }
}
