{
  "name": "fvttv12jsongenerator",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "foundry-modules/*",
    "tools/*"
  ],
  "scripts": {
    "test": "bun run src/tools/runHermeticFoundryScript.ts test:raw",
    "test:raw": "bun test --max-concurrency 4",
    "typecheck:production": "tsc -p tsconfig.production.json --pretty false",
    "typecheck:all": "tsc -p tsconfig.json --pretty false",
    "typecheck:packages": "tsc -p packages/contracts/tsconfig.json --pretty false && tsc -p packages/models/tsconfig.json --pretty false && tsc -p packages/spell-manifest-contracts/tsconfig.json --pretty false && tsc -p packages/parser/tsconfig.json --pretty false && tsc -p packages/generation/tsconfig.json --pretty false && tsc -p packages/workflows/tsconfig.json --pretty false && tsc -p packages/intake-ai/tsconfig.json --pretty false && tsc -p packages/ingest-plaintext/tsconfig.json --pretty false && tsc -p packages/ingest-documents/tsconfig.json --pretty false && tsc -p packages/crawl-goddessfantasy/tsconfig.json --pretty false && tsc -p packages/assets-icons/tsconfig.json --pretty false && tsc -p packages/blood-hunter-v14/tsconfig.json --pretty false",
    "typecheck:apps": "tsc -p apps/cli/tsconfig.json --pretty false && tsc -p apps/web/tsconfig.json --pretty false",
    "typecheck:foundry-modules": "tsc -p foundry-modules/chat-memory-guard/tsconfig.json --pretty false && tsc -p foundry-modules/session-monitor/tsconfig.json --pretty false && tsc -p foundry-modules/monster-spell-resolver/tsconfig.json --pretty false && tsc -p foundry-modules/fvtt-blood-hunter-2024/tsconfig.json --pretty false && tsc -p foundry-modules/fvtt-babele-rolltable-embed-translation/tsconfig.json --pretty false && tsc -p foundry-modules/fvtt-battlefield-painter/tsconfig.json --pretty false && tsc -p foundry-modules/fvtt-injury-fading-spirits/tsconfig.json --pretty false && tsc -p foundry-modules/fvtt-house-rules/tsconfig.json --pretty false",
    "typecheck:tools": "tsc -p tools/foundry-ops/tsconfig.json --pretty false",
    "architecture:deps": "bunx --bun depcruise --config .dependency-cruiser.cjs -- src packages apps foundry-modules tools scripts tests",
    "architecture:cycles": "bun node_modules/knip/bin/knip-bun.js --cycles --no-config-hints",
    "architecture:unused": "bun node_modules/knip/bin/knip-bun.js --no-exit-code --no-config-hints --reporter compact",
    "architecture:verify": "bun run architecture:deps && bun run architecture:cycles",
    "agents:generate": "ruler apply --agents agentsmd --local-only --no-nested --no-skills --no-subagents --no-mcp --no-gitignore --no-backup",
    "agents:check": "bun run src/tools/agentsInstructionsCheck.ts",
    "test-isolation:check": "bun run src/tools/foundryTestIsolationCheck.ts",
    "test-env:check": "bun run src/tools/ciEnvironmentCheck.ts",
    "coverage:verify": "bun run src/tools/coverageGate.ts coverage/lcov.info",
    "test:cli": "bun test --max-concurrency 1 tests/cli-ai-intake.test.ts tests/cli-item-intake.test.ts tests/cli-document-input.test.ts tests/cli-icon-mode.test.ts tests/cli-items.test.ts tests/cli-plaintext-actors.test.ts",
    "test:coverage:instrumented": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage --max-concurrency 2 --test-name-pattern \"^(?!AI monster intake CLI|CLI v14 safe icon mode|CLI item import|CLI plaintext actor import|Session Monitor subprocess build gate)\"",
    "test:coverage": "bun run test:cli && bun run test:coverage:instrumented && bun run coverage:verify",
    "smoke:actor:offline": "bun run src/tools/ciActorSmoke.ts",
    "hygiene:repository": "bun run src/tools/repositoryHygiene.ts",
    "ci:verify": "bun run src/tools/runHermeticFoundryScript.ts ci:verify:steps",
    "ci:verify:steps": "bun run test-env:check && bun run test-isolation:check && bun run agents:check && bun run typecheck:production && bun run typecheck:all && bun run typecheck:packages && bun run typecheck:apps && bun run typecheck:foundry-modules && bun run typecheck:tools && bun run architecture:verify && bun run test:session-monitor:build && bun run test:coverage && bun run audit:anti-overfit:all && bun run hygiene:repository && bun run references verify dnd5e-5.3.3 && bun run web:build && bun run smoke:actor:offline",
    "test:npc": "bun test tests/acceptance/alyxian-aboleth.acceptance.test.ts tests/acceptance/scuttling-serpentmaw.acceptance.test.ts tests/acceptance/slithering-bloodfin.acceptance.test.ts tests/e2e.test.ts src/core/generator/__tests__/phase1-validation.test.ts",
    "sync:vault": "bun run src/index.ts --sync --vault \"obsidian/dnd数据转fvttjson\"",
    "translate:pending": "bun run src/index.ts --translate-json --translate-dir \"data/need_tran\"",
    "cli:help": "bun run src/index.ts --help",
    "web:api": "bun run apps/web/src/server/index.ts",
    "web:dev": "bun run apps/web/src/dev.ts",
    "web:build": "vite build",
    "web:start": "bun run apps/web/src/server/index.ts",
    "verify:actor": "bun run src/tools/actorVerification.ts",
    "verify:intake": "bun run src/tools/intakeVerification.ts",
    "audit:anti-overfit": "bun run src/tools/antiOverfitAudit.ts",
    "audit:world-footprint": "bun run tools/foundry-ops/src/cli.ts world audit",
    "audit:anti-overfit:all": "bun run src/tools/antiOverfitAudit.ts --all",
    "foundry:ops": "bun run tools/foundry-ops/src/cli.ts",
    "foundry:lab": "bun run tools/foundry-ops/src/cli.ts lab",
    "test:foundry-ops": "bun run src/tools/runHermeticFoundryScript.ts test:foundry-ops:raw",
    "test:foundry-ops:raw": "bun test tools/foundry-ops/src scripts/foundry-lab/__tests__ --max-concurrency 4",
    "test:foundry-lab": "bun run src/tools/runHermeticFoundryScript.ts test:foundry-lab:raw",
    "test:foundry-lab:raw": "bun test tools/foundry-ops/src/lab/__tests__ scripts/foundry-lab/__tests__",
    "build:blood-hunter-v14": "bun run foundry-modules/fvtt-blood-hunter-2024/labCli.ts build",
    "install:blood-hunter-v14": "bun run foundry-modules/fvtt-blood-hunter-2024/labCli.ts install",
    "verify:blood-hunter-v14-install": "bun run foundry-modules/fvtt-blood-hunter-2024/labCli.ts verify-install",
    "test:blood-hunter-v14": "bun test packages/blood-hunter-v14/tests foundry-modules/fvtt-blood-hunter-2024/tests --max-concurrency 4",
    "build:spell-resolver": "bun run foundry-modules/monster-spell-resolver/build.ts",
    "install:spell-resolver": "bun run foundry-modules/monster-spell-resolver/labCli.ts install --apply",
    "verify:spell-resolver-install": "bun run foundry-modules/monster-spell-resolver/labCli.ts verify-install",
    "test:spell-resolver": "bun test src/core/spell-resolution foundry-modules/monster-spell-resolver/src",
    "build:chat-memory-guard": "bun run foundry-modules/chat-memory-guard/build.ts --workspace-root .",
    "install:chat-memory-guard": "bun run foundry-modules/chat-memory-guard/build.ts --workspace-root . --install",
    "test:chat-memory-guard": "bun test foundry-modules/chat-memory-guard/src --max-concurrency 4",
    "build:fvtt-babele-rolltable-embed-translation": "bun run foundry-modules/fvtt-babele-rolltable-embed-translation/build.ts",
    "install:fvtt-babele-rolltable-embed-translation": "bun run foundry-modules/fvtt-babele-rolltable-embed-translation/labCli.ts install --apply",
    "verify-install:fvtt-babele-rolltable-embed-translation": "bun run foundry-modules/fvtt-babele-rolltable-embed-translation/labCli.ts verify-install",
    "test:fvtt-babele-rolltable-embed-translation": "bun test foundry-modules/fvtt-babele-rolltable-embed-translation/src --max-concurrency 4",
    "build:injury-fading-spirits": "bun run foundry-modules/fvtt-injury-fading-spirits/build.ts",
    "install:injury-fading-spirits": "bun run foundry-modules/fvtt-injury-fading-spirits/labCli.ts install --apply",
    "verify-install:injury-fading-spirits": "bun run foundry-modules/fvtt-injury-fading-spirits/labCli.ts verify-install",
    "test:injury-fading-spirits": "bun test foundry-modules/fvtt-injury-fading-spirits/tests --max-concurrency 4",
    "build:house-rules": "bun run foundry-modules/fvtt-house-rules/scripts/build.ts",
    "install:house-rules": "bun run foundry-modules/fvtt-house-rules/scripts/install-local-lab.ts",
    "verify-install:house-rules": "bun run foundry-modules/fvtt-house-rules/scripts/verify-local-lab.ts",
    "test:house-rules": "bun test foundry-modules/fvtt-house-rules/tests --max-concurrency 4",
    "build:session-monitor": "bun run foundry-modules/session-monitor/build.ts --workspace-root .",
    "install:session-monitor": "bun run foundry-modules/session-monitor/build.ts --workspace-root . --install",
    "test:session-monitor": "bun test foundry-modules/session-monitor/src foundry-modules/session-monitor/companion --max-concurrency 4",
    "test:session-monitor:build": "bun test foundry-modules/session-monitor/companion/release.test.ts --max-concurrency 1 --test-name-pattern \"Session Monitor subprocess build gate\"",
    "monitor:session": "bun run foundry-modules/session-monitor/companion/cli.ts --workspace-root .",
    "build:icon-catalog:v14": "bun run scripts/buildV14IconCatalog.ts",
    "review:icons:v14": "bun run src/tools/iconReviewGallery.ts",
    "references": "bun run src/tools/referenceCache.ts",
    "document:doctor": "bun run src/index.ts --document-doctor"
  },
  "devDependencies": {
    "@intellectronica/ruler": "0.3.44",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dependency-cruiser": "^18.1.0",
    "knip": "^6.29.0",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fvtt-json-generator/assets-icons": "workspace:*",
    "@fvtt-json-generator/contracts": "workspace:*",
    "@fvtt-json-generator/crawl-goddessfantasy": "workspace:*",
    "@fvtt-json-generator/generation": "workspace:*",
    "@fvtt-json-generator/intake-ai": "workspace:*",
    "@fvtt-json-generator/ingest-documents": "workspace:*",
    "@fvtt-json-generator/ingest-plaintext": "workspace:*",
    "@fvtt-json-generator/models": "workspace:*",
    "@fvtt-json-generator/parser": "workspace:*",
    "@fvtt-json-generator/spell-manifest-contracts": "workspace:*",
    "@fvtt-json-generator/workflows": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "cheerio": "^1.2.0",
    "commander": "^14.0.2",
    "crawlee": "^3.17.0",
    "domhandler": "^6.0.1",
    "js-yaml": "^4.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.2"
  }
}
