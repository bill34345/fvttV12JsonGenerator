# Repository-safe default: copy this file to .env and fill in the provider key.
# The committed example intentionally uses API key mode.
MONSTER_INTAKE_AUTH_MODE=api-key
MONSTER_INTAKE_API_KEY=
MONSTER_INTAKE_BASE_URL=https://api.openai.com/v1
MONSTER_INTAKE_MODEL=
MONSTER_INTAKE_REVIEW_MODEL=
MONSTER_INTAKE_TIMEOUT_MS=60000
# Optional longer timeout for the evidence-preserving repair stage.
MONSTER_INTAKE_REPAIR_TIMEOUT_MS=180000

# Local Codex OAuth is a machine-local override, not the repository default.
# It requires the local OpenAI-compatible bridge to be running:
# MONSTER_INTAKE_AUTH_MODE=codex-oauth
# MONSTER_INTAKE_CODEX_OAUTH_BASE_URL=http://127.0.0.1:8787/v1
# MONSTER_INTAKE_MODEL=gpt-5.6-luna
# MONSTER_INTAKE_CODEX_OAUTH_REASONING_EFFORT=xhigh
