<section class="custom-conditions-manager">
  <p class="hint">{{localize "FVTTCONDITIONS.Manager.TargetHint"}}</p>
  <p class="hint">{{localize "FVTTCONDITIONS.Manager.EscapeHint"}}</p>
  {{#if injury.enabled}}
    <section class="injury-panel">
      <header><h3><img src="{{injury.img}}" alt="{{injury.name}}"> {{injury.name}}</h3></header>
      <p class="hint">{{injury.description}}</p>
      {{#each injury.actors}}
        <article class="injury-entry" data-actor-uuid="{{actorUuid}}">
          {{#if error}}<strong>{{actorName}}</strong><span class="error">{{error}}</span>{{else}}
          <img src="{{img}}" alt="{{actorName}}">
          <strong>{{actorName}}</strong>
          <span>{{stacks}}/{{maxStacks}}</span>
          {{#if canDecrease}}<button type="button" data-action="decreaseInjury" data-actor-uuid="{{actorUuid}}">{{localize "FVTTCONDITIONS.Manager.InjuryDecrease"}}</button>{{/if}}
          {{#if canIncrease}}<button type="button" data-action="increaseInjury" data-actor-uuid="{{actorUuid}}">{{localize "FVTTCONDITIONS.Manager.InjuryIncrease"}}</button>{{/if}}
          {{#if ../injury.resurrectionAvailable}}<button type="button" data-action="openInjuryWizard" data-actor-uuid="{{actorUuid}}">{{localize "FVTTCONDITIONS.Manager.InjuryResurrection"}}</button>{{/if}}
          {{/if}}
        </article>
      {{else}}
        <p class="hint">{{localize "FVTTCONDITIONS.Manager.InjuryNoTargets"}}</p>
      {{/each}}
    </section>
  {{/if}}
  {{#if genericAvailable}}
  <section class="configured-manager-panel">
    <header><h3>{{localize "FVTTCONDITIONS.Configured.Title"}}</h3>
      <button type="button" data-action="openConfiguredEditor">{{localize "FVTTCONDITIONS.Configured.OpenEditor"}}</button></header>
    <p class="hint">{{localize "FVTTCONDITIONS.Configured.ManagerHint"}}</p>
    {{#if configuredDefinitions.length}}
      <div class="form-group"><label>{{localize "FVTTCONDITIONS.Configured.Choose"}}</label>
        <select name="configuredDefinitionId">
          {{#each configuredDefinitions}}<option value="{{id}}">{{name}}</option>{{/each}}
        </select>
        <button type="button" data-action="applyConfigured">{{localize "FVTTCONDITIONS.Manager.Apply"}}</button>
      </div>
    {{/if}}
    {{#each actors}}
      {{#if configuredConditions.length}}
        <h4>{{name}}</h4>
        <ul class="condition-list">
          {{#each configuredConditions}}
            <li><span><strong>{{name}}</strong> · {{#if disabled}}{{localize "FVTTCONDITIONS.Manager.Disabled"}}{{else}}{{localize "FVTTCONDITIONS.Manager.Enabled"}}{{/if}}
              {{#if skippedLabel}} · {{localize "FVTTCONDITIONS.Configured.ImmuneSkipped"}} {{skippedLabel}}{{/if}}</span>
              <span class="condition-actions">
                {{#if frozenComponentId}}<button type="button" data-action="escapeConfiguredFrozen" data-actor-uuid="{{actorUuid}}" data-instance-id="{{instanceId}}">{{localize "FVTTCONDITIONS.Manager.EscapeFrozen"}}</button>{{/if}}
                <button type="button" data-action="toggleConfigured" data-actor-uuid="{{actorUuid}}" data-instance-id="{{instanceId}}">{{localize "FVTTCONDITIONS.Manager.Toggle"}}</button>
                <button type="button" data-action="removeConfigured" data-actor-uuid="{{actorUuid}}" data-instance-id="{{instanceId}}">{{localize "FVTTCONDITIONS.Manager.Remove"}}</button>
              </span>
            </li>
          {{/each}}
        </ul>
      {{/if}}
    {{/each}}
  </section>
  <div class="condition-targets">
    {{#each actors}}
      <article data-actor-uuid="{{uuid}}">
        <header><strong>{{name}}</strong></header>
        {{#if conditions.length}}
          <ul class="condition-list">
            {{#each conditions}}
              <li>
                <span><img class="condition-icon" src="{{img}}" alt="{{conditionLabel}}"><strong>{{name}}</strong> · {{conditionLabel}} · {{description}} · {{#if disabled}}{{localize "FVTTCONDITIONS.Manager.Disabled"}}{{else}}{{localize "FVTTCONDITIONS.Manager.Enabled"}}{{/if}}</span>
                <span class="condition-actions">
                  {{#if canEscapeFrozen}}<button type="button" data-action="escapeFrozen" data-actor-uuid="{{actorUuid}}" data-effect-id="{{id}}">{{localize "FVTTCONDITIONS.Manager.EscapeFrozen"}}</button>{{/if}}
                  <button type="button" data-action="edit" data-actor-uuid="{{actorUuid}}" data-effect-id="{{id}}">{{localize "FVTTCONDITIONS.Manager.Edit"}}</button>
                  <button type="button" data-action="toggle" data-actor-uuid="{{actorUuid}}" data-effect-id="{{id}}">{{localize "FVTTCONDITIONS.Manager.Toggle"}}</button>
                  <button type="button" data-action="remove" data-actor-uuid="{{actorUuid}}" data-effect-id="{{id}}">{{localize "FVTTCONDITIONS.Manager.Remove"}}</button>
                </span>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="hint">{{localize "FVTTCONDITIONS.Manager.Empty"}}</p>
        {{/if}}
      </article>
    {{else}}
      <p>{{localize "FVTTCONDITIONS.Manager.NoTargets"}}</p>
    {{/each}}
  </div>
  <div class="condition-form">
    <div class="form-group">
      <label>{{localize "FVTTCONDITIONS.Manager.Condition"}}</label>
      <select name="conditionId">{{#each definitions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} · {{description}}</option>{{/each}}</select>
    </div>
    <div class="form-group"><label>{{localize "FVTTCONDITIONS.Manager.Name"}}</label><input name="sourceName" value="{{sourceName}}" maxlength="120"></div>
    <div class="form-group"><label>{{localize "FVTTCONDITIONS.Manager.Origin"}}</label><input name="origin" value="{{origin}}" maxlength="4000"></div>
    <div class="form-group stacked"><label>{{localize "FVTTCONDITIONS.Manager.Params"}}</label><textarea name="paramsJson" rows="15" spellcheck="false">{{paramsJson}}</textarea></div>
    <button type="button" data-action="refresh">{{localize "FVTTCONDITIONS.Manager.Refresh"}}</button>
  </div>
  {{/if}}
</section>
