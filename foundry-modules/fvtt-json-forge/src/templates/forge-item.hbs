<section data-forge-pane="formal" class="fvtt-json-forge-form forge-item-panel forge-card-editor" aria-label="创建物品">
  <div class="forge-card-columns">
    <section class="forge-card-input" aria-labelledby="forge-item-heading">
      <h2 id="forge-item-heading">来源</h2>
      <p data-item-file-name class="forge-card-source-name"></p>
      <input type="hidden" name="mode" value="structured">
      <label class="forge-icon-upload forge-choose-source">选择资料文件
        <input name="sourceFile" type="file" accept=".md,.txt,text/plain,text/markdown">
      </label>
      <details class="forge-source-editor" data-document-source-editor>
        <summary>粘贴或编辑资料</summary>
        <label>物品资料 <textarea name="source" rows="12" spellcheck="false" placeholder="粘贴标准物品资料"></textarea></label>
        <label>物品名称（可选） <input name="displayName" type="text" autocomplete="off"></label>
      </details>
      <article class="forge-source-reading" data-document-source aria-label="原文" hidden></article>
      <label hidden>装备阶段 <select name="itemStage"></select></label>
    </section>

    <section class="forge-card-review" aria-label="物品预览">
      <div class="forge-card-review-title"><strong>物品预览</strong><span data-item-preview-state></span></div>
      <p class="forge-card-empty" data-item-empty>选择文件或粘贴资料，即可预览物品。</p>
      <section data-diagnostics class="forge-card-findings" hidden>
        <h3>需要核对</h3>
        <ul data-diagnostic-list></ul>
      </section>
      <section data-preview hidden>
        <div class="forge-paper-card">
          <div data-preview-text></div>
          <section class="forge-card-art" data-item-icon hidden></section>
        </div>
      </section>
    </section>
  </div>
  <footer class="forge-action-bar forge-document-actions">
    <div class="forge-action-bar-row">
      <div class="forge-action-bar-start">
        <button type="button" data-action="clear" hidden>清空资料</button>
        <button type="button" data-action="cancel" hidden>停止处理</button>
        <span data-created-document role="status" hidden><strong data-created-summary>物品已创建</strong></span>
      </div>
      <div class="forge-action-bar-end">
        <p class="forge-card-destination" data-forge-destination="Item"></p>
        <button type="button" data-action="generate">预览物品</button>
        <button type="button" data-action="create" disabled>创建物品</button>
        <button type="button" data-action="open-created" disabled>打开物品卡</button>
      </div>
    </div>
    <p data-status class="forge-card-status" role="status" aria-live="polite"></p>
    <p class="forge-card-status forge-error" data-error role="alert" hidden></p>
  </footer>
</section>
