<section data-forge-pane="intake" class="fvtt-json-forge-form forge-intake-panel forge-workspace" aria-labelledby="forge-workspace-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">
  <header class="forge-workspace-header">
    <div class="forge-workspace-title">
      <h2 id="forge-workspace-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">{{directoryTitle}}</h2>
      <p>粘贴或读取来源，准备好后分析。</p>
    </div>
    <div class="forge-workspace-header-tools">
      <div class="forge-connection-strip" aria-label="AI 连接状态">
        <span data-connection-summary>读取当前 AI 配置…</span>
        <span data-connection-status role="status" aria-live="polite"></span>
      </div>
      <button type="button" data-action="connection-open" class="forge-settings-link"><i class="fas fa-sliders" aria-hidden="true"></i> 连接设置</button>
    </div>
  </header>

  <nav class="forge-step-nav" data-step-nav aria-label="工作进度">
    <ol>
      <li data-step-indicator="input" data-active="true" aria-current="step">输入</li>
      <li data-step-indicator="review" data-active="false">审核</li>
      <li data-step-indicator="created" data-active="false">完成</li>
    </ol>
  </nav>

  <div class="forge-workspace-scroll" data-workspace-scroll>
    <div class="forge-stage-stack">
      <section class="forge-step forge-input-step" data-step="input" aria-labelledby="forge-input-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">
        <header class="forge-step-heading">
          <h3 id="forge-input-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">来源编辑器</h3>
          <p>{{#if isItemDirectory}}粘贴完整物品规则或读取文件。{{else}}一次提供一只生物的完整资料；多只生物资料请使用“生物与召唤物”。{{/if}}分析和预览不会创建目录条目。</p>
        </header>

        <div class="forge-source-layout" data-source-editor>
          <label class="forge-source-text">原始来源
            <textarea name="source" rows="14" placeholder="在这里粘贴生物或物品的完整规则描述……" spellcheck="false" required></textarea>
          </label>
          <div class="forge-source-file-panel">
            <label class="forge-source-file">读取 Markdown / TXT
              <input name="sourceFile" type="file" accept=".md,.txt,text/plain,text/markdown">
            </label>
            <small>读取后仍可编辑来源文本。</small>
          </div>
        </div>

        <div class="forge-input-support">
          {{#if isItemDirectory}}
          <input type="hidden" name="mode" value="ai-item">
          <details class="forge-more-options" data-input-options>
            <summary>来源设置</summary>
            <div class="forge-input-grid">
              <label>显示名称（可选）
                <input name="displayName" type="text" autocomplete="off" placeholder="留空时使用资料文件名">
              </label>
            </div>
          </details>
          {{else}}
          <details class="forge-more-options" data-input-options>
            <summary>来源设置</summary>
            <div class="forge-input-grid">
              <label>处理方式
                <select name="mode">
                  <option value="ai-monster">AI 整理生物</option>
                  <option value="plaintext-actor">纯文本审阅 · 无需 AI</option>
                </select>
              </label>
              <label>显示名称（可选）
                <input name="displayName" type="text" autocomplete="off" placeholder="留空时使用资料文件名">
              </label>
            </div>
          </details>
          {{/if}}

          <details class="forge-secondary-imports">
            <summary>其他导入方式</summary>
            <div class="forge-quick-entry" aria-label="其他导入方式">
              <div>
                <strong>已有规范资料？</strong>
                <span>直接打开标准 Markdown，跳过 AI。</span>
              </div>
              <button type="button" data-action="structured-open">导入标准资料</button>
              {{#if isActorDirectory}}
              <div>
                <strong>生物与召唤物</strong>
                <span>生成生物，以及能力关联的召唤生物或物件。</span>
              </div>
              <button type="button" data-action="encounter-open">打开生物与召唤物</button>
              {{/if}}
            </div>
          </details>
        </div>
      </section>

      <section class="forge-step forge-review-step" data-step="review" aria-labelledby="forge-review-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}" hidden>
        <header class="forge-step-heading">
          <h3 id="forge-review-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">审核结果</h3>
          <p data-human-summary>结果会显示在这里。核对来源与需要处理的问题后，再创建到目录。</p>
        </header>

        <p class="forge-status" data-status tabindex="-1" role="status" aria-live="polite">等待输入资料</p>
        <section class="forge-findings forge-diagnostics" data-diagnostics hidden tabindex="-1">
          <h4>内容疑点与未匹配项</h4>
          <p>以下问题供你核对，不阻止 AI 角色生成或创建。审核提示仅保留在 Forge 中，不写入角色或角色 JSON。</p>
          <ul data-diagnostic-list></ul>
        </section>
        <div data-human-preview class="forge-human-preview"></div>
        <details><summary>Icon 选图依据与近似程度</summary><pre data-icon-review></pre></details>

        <section data-preview-section hidden class="forge-review-grid">
          <details class="forge-human-review">
            <summary>查看原始来源</summary>
            <pre data-raw-source></pre>
          </details>
          <details class="forge-human-review">
            <summary>查看来源依据</summary>
            <pre data-evidence></pre>
          </details>
          <details class="forge-technical-details">
            <summary>技术详情</summary>
            <div class="forge-technical-grid">
              <details>
                <summary>结果核对数据</summary>
                <pre data-preview></pre>
              </details>
              <details>
                <summary>候选边界</summary>
                <pre data-candidate></pre>
              </details>
              <details>
                <summary>Provider、model、calls、history</summary>
                <pre data-metadata></pre>
              </details>
              <details>
                <summary>标准化来源</summary>
                <pre data-canonical></pre>
              </details>
              <details>
                <summary>生成 JSON</summary>
                {{#unless isItemDirectory}}<p>此处为完整 Actor JSON，与下载内容相同，可复制保存。</p>{{/unless}}
                <pre data-json></pre>
              </details>
            </div>
          </details>
        </section>
      </section>

      <section class="forge-step forge-created-step" data-step="created" aria-labelledby="forge-created-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}" hidden>
        <header class="forge-step-heading">
          <h3 id="forge-created-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">已创建</h3>
          <p>条目已创建。请查看下方录入差异和内容疑点；创建完成不代表内容全部正确。</p>
        </header>
        <section data-created-document class="forge-created-document" role="status" tabindex="-1" hidden></section>
        <button type="button" data-action="refresh-result">刷新录入与施法提示</button>
        <section class="forge-findings forge-diagnostics" data-completion-diagnostics hidden role="status">
          <h4>已创建，以下内容仍需核对</h4>
          <p>创建完成不代表这些内容已经匹配正确。提示保留在 Forge 中，不写入角色或角色 JSON。</p>
          <ul data-completion-issues></ul>
        </section>
      </section>
    </div>

    <section class="forge-activity-card" data-activity-card hidden aria-live="polite">
      <div class="forge-activity-heading">
        <h4>当前请求</h4>
        <span>实时状态</span>
      </div>
      <p data-activity-summary>尚未开始请求。</p>
      <p data-activity-detail></p>
    </section>

    <details class="forge-stage-details" data-review-progress>
      <summary>处理阶段</summary>
      <ol data-stages aria-label="处理阶段"></ol>
    </details>

    <details class="forge-advanced-workspace" data-advanced-workspace>
      <summary>更多工具：历史记录、资料库与批量处理</summary>
      <section class="forge-import-card" aria-labelledby="forge-import-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">
        <div>
          <h3 id="forge-import-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">载入历史审核记录</h3>
          <p>最多 4 MiB。导入只恢复安全审阅投影，不会调用 Provider、恢复旧请求或创建世界 Document；历史 accepted 也必须开启全新 attempt。</p>
        </div>
        <label>审核记录 JSON
          <input name="reviewBundleFile" type="file" accept="application/json,.json">
        </label>
        <button type="button" data-action="import" disabled>载入审核记录</button>
      </section>

      <details class="forge-source-library" aria-labelledby="forge-source-library-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">
        <summary id="forge-source-library-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">资料库</summary>
        <p class="forge-library-warning">记录保存在当前浏览器、当前 world/GM scope 的 IndexedDB 中，不写世界 settings/flags，也不是加密保险箱；同一 Foundry origin 的其他模块理论上可以读取。它不会自动 Analyze、调用 Provider、恢复旧请求或创建世界 Document。</p>
        <div class="forge-library-toolbar">
          <label>搜索资料
            <input name="sourceLibrarySearch" type="search" autocomplete="off" placeholder="名称、内容或状态…">
          </label>
          <button type="button" data-action="library-refresh">刷新</button>
          <button type="button" data-action="library-save" disabled>保存当前资料</button>
          <button type="button" data-action="library-export" disabled>导出资料库</button>
        </div>
        <div class="forge-library-import">
          <label>资料库文件（最多 64 MiB）
            <input name="sourceLibraryFile" type="file" accept="application/json,.json">
          </label>
          <button type="button" data-action="library-import" disabled>读取并合并</button>
        </div>
        <p data-library-summary role="status" aria-live="polite">资料库尚未加载。</p>
        <div data-library-list class="forge-library-list"><p>暂无可显示记录。</p></div>
      </details>

      <details class="forge-source-library forge-batch-queue" aria-labelledby="forge-batch-queue-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">
        <summary id="forge-batch-queue-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">批量处理</summary>
        <p class="forge-library-warning">队列保存在当前浏览器、当前 world/GM scope。GM 显式启动后只以 concurrency 1 顺序运行；关页或刷新会把 running/applying 标为 interrupted，不会在后台自动重发 Provider 请求，也不会自动请求付费审核。只有当前页面仍持有完整候选的 job 才能由 GM 批量确认创建。</p>
        <div class="forge-library-import forge-batch-import">
          <label>Collection JSON / ZIP / Portable queue（最多 64 MiB）
            <input name="batchCollectionFile" type="file" accept="application/json,application/zip,.json,.zip">
          </label>
          <button type="button" data-action="batch-import" disabled>读取并合并</button>
        </div>
        <div class="forge-library-toolbar forge-batch-toolbar">
          <button type="button" data-action="batch-refresh">刷新队列</button>
          <button type="button" data-action="batch-export" disabled>导出队列</button>
          <button type="button" data-action="batch-run" disabled>开始／继续批量处理</button>
          <button type="button" data-action="batch-stop" disabled>停止队列</button>
          <button type="button" data-action="batch-apply" disabled>GM 批量确认创建本地有效候选</button>
        </div>
        <p data-batch-summary role="status" aria-live="polite">队列尚未加载。</p>
        <p>完整 AI 候选在本机按世界和 GM 保留 7 天，总额度 8 MiB。刷新后本地重验，不自动请求模型，须重新确认。</p>
        <div class="forge-actions">
          <button type="button" data-action="restore-candidate" disabled>恢复上次单条候选</button>
          <button type="button" data-action="clear-candidate-cache">清除全部候选恢复记录</button>
        </div>
        <p>仅清除当前浏览器、当前世界、当前 GM 的全部单条和批量候选恢复记录；当前页面结果、Actor、Item、来源库和队列均保留。</p>
        <div data-batch-list class="forge-library-list forge-batch-list"><p>暂无 Collection 或 queue job。</p></div>
      </details>
    </details>
  </div>

  <footer class="forge-workspace-actions" data-workspace-actions>
    <div class="forge-workspace-action-row">
      <button type="button" data-action="analyze" data-workspace-action data-primary="true">分析资料</button>
      <button type="button" data-action="edit-source" data-workspace-action data-primary="false" hidden>返回编辑</button>
      <button type="button" data-action="resume-review" data-workspace-action data-primary="false" hidden>继续查看结果</button>
      <button type="button" data-action="generate" data-workspace-action data-primary="false" hidden>生成候选并本地校验</button>
      <button type="button" data-action="create" data-workspace-action data-primary="false" hidden>GM确认创建</button>
      <button type="button" data-action="repair" data-workspace-action data-primary="false" hidden>修正问题</button>
      <button type="button" data-action="regenerate" data-workspace-action data-primary="false" hidden>重新分析</button>
      <button type="button" data-action="open-created" data-workspace-action data-primary="false" hidden>打开已创建条目</button>
      <button type="button" data-action="start-new-attempt" data-workspace-action data-primary="false" hidden>开始新一轮</button>
      <span class="forge-workspace-secondary-actions">
        <button type="button" class="forge-secondary-action" data-action="clear" data-workspace-action data-primary="false">清空资料</button>
        <button type="button" class="forge-running-cancel forge-secondary-action" data-action="cancel" data-workspace-action data-primary="false" hidden disabled>结束请求</button>
      </span>
    </div>
    <details class="forge-workspace-more" data-workspace-more hidden>
      <summary>更多操作</summary>
      <div class="forge-workspace-more-actions">
        <button type="button" data-action="download-actor" data-workspace-action data-primary="false" hidden>下载 Actor JSON 候选</button>
        <button type="button" data-action="export" data-workspace-action data-primary="false" hidden>导出审核记录</button>
        <button type="button" data-action="reject" data-workspace-action data-primary="false" hidden>不采用本次结果</button>
      </div>
    </details>
    <p class="forge-workspace-hint" data-workspace-hint role="status" aria-live="polite">粘贴完整规则或读取文件，先分析，再由你确认创建。</p>
  </footer>
</section>
