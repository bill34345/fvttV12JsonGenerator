<section data-forge-pane="intake" class="fvtt-json-forge-form forge-intake-panel forge-workspace" data-library-view="{{recordsView}}" aria-labelledby="forge-workspace-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">
  <header class="forge-workspace-header">
    <div class="forge-workspace-title">
      <h2 id="forge-workspace-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">{{directoryTitle}}</h2>
      <p>粘贴或读取来源，准备好后分析。</p>
    </div>
    <div class="forge-workspace-header-tools">
      <div class="forge-connection-strip" aria-label="AI 连接状态">
        <span data-connection-summary>读取当前 AI 配置…</span>
        <span data-connection-status role="status" aria-live="polite"></span>
      </div>
      <button type="button" data-action="connection-open" class="forge-settings-link"><i class="fas fa-sliders" aria-hidden="true"></i> 连接设置</button>
    </div>
  </header>

  <nav class="forge-step-nav" data-step-nav aria-label="工作进度">
    <ol>
      <li data-step-indicator="input" data-active="true" aria-current="step">输入</li>
      <li data-step-indicator="review" data-active="false">审核</li>
      <li data-step-indicator="created" data-active="false">完成</li>
    </ol>
  </nav>

  <nav class="forge-records-nav" aria-label="资料与任务">
    <div role="group" aria-label="工作区">
      <button type="button" data-action="view-saved" aria-pressed="{{showRecordsSaved}}">资料库</button>
      <button type="button" data-action="view-batch" aria-pressed="{{showRecordsBatch}}">批量处理</button>
    </div>
  </nav>

  <div class="forge-workspace-scroll" data-workspace-scroll>
    <div class="forge-stage-stack" data-library-panel="editor" {{#unless showRecordsEditor}}hidden{{/unless}}>
      <section class="forge-step forge-input-step" data-step="input" aria-labelledby="forge-input-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">
        <header class="forge-step-heading">
          <h3 id="forge-input-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">{{#if isItemDirectory}}物品资料{{else}}生物资料{{/if}}</h3>
          {{#if isActorDirectory}}<p>多只生物请使用「生物与召唤物」。</p>{{/if}}
        </header>

        <div class="forge-source-layout" data-source-editor>
          <label class="forge-source-text">原文
            <textarea name="source" rows="14" placeholder="在这里粘贴生物或物品的完整规则描述……" spellcheck="false" required></textarea>
          </label>
          <div class="forge-source-file-panel">
            <label class="forge-source-file">读取 Markdown / TXT / PDF
              <input name="sourceFile" type="file" accept=".md,.txt,.pdf,text/plain,text/markdown,application/pdf">
            </label>
            <small>{{#if isActorDirectory}}选择 PDF 后填写生物名称。{{else}}PDF 需要有可选中的文字。{{/if}}</small>
            {{#if isItemDirectory}}
            <div data-item-pdf-fields hidden>
              <p data-item-pdf-file></p>
              <label>PDF 物品名称 <input name="itemPdfName" type="text" autocomplete="off"></label>
              <label>物理页码（可选） <input name="itemPdfPages" type="text" placeholder="例如 12 或 12-13"></label>
            </div>
            {{/if}}
          </div>
        </div>

        <div class="forge-input-support">
          {{#if isItemDirectory}}
          <input type="hidden" name="mode" value="ai-item">
          <details class="forge-more-options" data-input-options>
            <summary>来源设置</summary>
            <div class="forge-input-grid">
              <label>显示名称（可选）
                <input name="displayName" type="text" autocomplete="off" placeholder="留空时使用资料文件名">
              </label>
            </div>
          </details>
          {{else}}
          <details class="forge-more-options" data-input-options>
            <summary>来源设置</summary>
            <div class="forge-input-grid">
              <label>处理方式
                <select name="mode">
                  <option value="ai-monster">AI 整理生物</option>
                  <option value="plaintext-actor">纯文本审阅 · 无需 AI</option>
                </select>
              </label>
              <label>显示名称（可选）
                <input name="displayName" type="text" autocomplete="off" placeholder="留空时使用资料文件名">
              </label>
            </div>
          </details>
          {{/if}}

          <details class="forge-secondary-imports">
            <summary>其他导入方式</summary>
            <div class="forge-quick-entry" aria-label="其他导入方式">
              <div>
                <strong>已有标准资料？</strong>
                <span>直接打开标准 Markdown，跳过 AI。</span>
              </div>
              <button type="button" data-action="structured-open">导入标准资料</button>
              {{#if isActorDirectory}}
              <div>
                <strong>生物与召唤物</strong>
                <span>生成生物，以及能力关联的召唤生物或物件。</span>
              </div>
              <button type="button" data-action="encounter-open">打开生物与召唤物</button>
              {{/if}}
            </div>
          </details>
        </div>
      </section>

      <section class="forge-step forge-review-step" data-step="review" aria-labelledby="forge-review-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}" hidden>
        <h3 class="forge-visually-hidden" id="forge-review-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">核对资料</h3>
        <p class="forge-review-message" data-human-summary></p>
        {{#if isItemDirectory}}<label hidden>装备阶段 <select name="itemStage"></select></label>{{/if}}
        <details class="forge-findings forge-diagnostics" data-diagnostics hidden tabindex="-1">
          <summary>内容疑点与未匹配项</summary>
          <ul data-diagnostic-list></ul>
        </details>
        {{#if isItemDirectory}}
        <p data-item-pdf-notices role="status"></p>
        <section data-item-icon hidden></section>
        {{/if}}
        <div data-human-preview class="forge-human-preview" hidden></div>
        <pre data-raw-source hidden></pre>
        <div data-preview-section hidden class="forge-intake-reader"></div>
      </section>

      <section class="forge-step forge-created-step" data-step="created" aria-labelledby="forge-created-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}" hidden>
        <header class="forge-step-heading">
          <h3 id="forge-created-heading-{{#if isItemDirectory}}item{{else}}actor{{/if}}">已创建</h3>
        </header>
        <section data-created-document class="forge-created-document" role="status" tabindex="-1" hidden></section>
        <button type="button" data-action="refresh-result">刷新录入与施法提示</button>
        <section class="forge-findings forge-diagnostics" data-completion-diagnostics hidden role="status">
          <h4>已创建，以下内容仍需核对</h4>
          <ul data-completion-issues></ul>
        </section>
      </section>
    </div>

    <section class="forge-activity-card" data-activity-card hidden aria-live="polite">
      <div class="forge-activity-heading">
        <h4>当前请求</h4>
        <span>实时状态</span>
      </div>
      <p data-activity-summary>尚未开始请求。</p>
      <p data-activity-detail></p>
    </section>

    <section class="forge-records-panel forge-source-library" data-library-panel="saved" aria-labelledby="forge-library-title-{{#if isItemDirectory}}item{{else}}actor{{/if}}" {{#unless showRecordsSaved}}hidden{{/unless}}>
      <h2 class="forge-visually-hidden" id="forge-library-title-{{#if isItemDirectory}}item{{else}}actor{{/if}}">资料库</h2>
      <div data-library-index>
      <header class="forge-records-toolbar forge-library-toolbar">
        <label class="forge-records-search"><i class="fas fa-search" aria-hidden="true"></i>
          <span class="forge-visually-hidden">搜索已保存的资料</span>
          <input name="sourceLibrarySearch" type="search" autocomplete="off" placeholder="搜索名称或内容">
        </label>
        <p data-library-summary role="status" aria-live="polite">正在读取资料…</p>
        <div class="forge-records-tools">
          <button type="button" data-action="library-refresh" title="刷新资料库"><i class="fas fa-rotate" aria-hidden="true"></i> 刷新</button>
          <details class="forge-records-menu"><summary>导入与管理</summary>
            <div class="forge-records-menu-body">
              <label>导入资料库<input name="sourceLibraryFile" type="file" accept="application/json,.json"></label>
              <button type="button" data-action="library-import" disabled>导入资料</button>
              <label>导入预览记录<input name="reviewBundleFile" type="file" accept="application/json,.json"></label>
              <button type="button" data-action="import" disabled>打开预览记录</button>
              <hr>
              <button type="button" data-action="library-export" disabled>导出整个资料库</button>
              <button type="button" data-action="clear-candidate-cache">清除自动保存的预览</button>
            </div>
          </details>
        </div>
      </header>
      <p class="forge-library-purpose">这里保存输入原文和历次整理记录。打开原文或记录即可阅读。</p>
      <div data-library-list role="group" aria-label="已保存的资料"></div>
      </div>
      <section class="forge-record-detail" data-library-detail aria-label="资料详情" hidden>
        <header class="forge-record-detail-heading">
          <h3 data-library-detail-title></h3>
          <p data-library-detail-kind></p>
          <button type="button" data-action="library-back">返回资料库</button>
        </header>
        <div data-library-reader class="forge-intake-reader"></div>
      </section>
    </section>

    <section class="forge-records-panel forge-batch-workbench" data-library-panel="batch" aria-label="批量处理" {{#unless showRecordsBatch}}hidden{{/unless}}>
      <div class="forge-batch-queue" data-batch-queue>
      <header class="forge-records-toolbar forge-batch-toolbar">
        <div class="forge-batch-import">
          <label>
            <span class="forge-visually-hidden">选择批量资料</span>
            <input name="batchCollectionFile" type="file" accept="application/json,application/zip,.json,.zip">
          </label>
          <button type="button" data-action="batch-import" disabled>导入任务</button>
        </div>
        <p data-batch-summary role="status" aria-live="polite">正在读取任务…</p>
        <div class="forge-records-tools">
          <button type="button" data-action="batch-refresh">刷新</button>
          <details class="forge-records-menu"><summary>导出队列</summary><div class="forge-records-menu-body">
            <button type="button" data-action="batch-export" disabled>导出全部任务</button>
          </div></details>
        </div>
      </header>
      <div data-batch-list class="forge-library-list forge-records-list"></div>
      </div>
      <section data-batch-review class="forge-batch-review" hidden aria-label="任务核对">
        <header class="forge-record-detail-heading">
          <h3 data-batch-review-title></h3>
          <p data-batch-review-status></p>
          <button type="button" data-action="batch-return" hidden>返回队列</button>
        </header>
        <details class="forge-findings forge-diagnostics" data-batch-review-issues hidden>
          <summary>需要核对的内容</summary>
          <ul data-batch-review-issue-list></ul>
        </details>
        <div data-batch-reader class="forge-intake-reader"></div>
      </section>
    </section>
  </div>

  <footer class="forge-records-footer forge-action-bar">
    <div class="forge-action-bar-row">
      <div class="forge-action-bar-start">
        <button type="button" data-action="view-editor" aria-pressed="{{showRecordsEditor}}">返回当前资料</button>
      </div>
      <p class="forge-records-footnote"><i class="fas fa-laptop" aria-hidden="true"></i> 保存在当前浏览器，换设备前可导出。</p>
      <div data-library-edit-actions class="forge-action-bar-end" hidden>
        <button type="button" data-action="library-load-source" data-primary="true">载入原文编辑</button>
      </div>
      <div data-batch-footer {{#unless showRecordsBatch}}hidden{{/unless}}>
        <p data-batch-selection role="status" aria-live="polite"></p>
        <div class="forge-batch-queue-actions forge-action-bar-end">
          <button type="button" data-action="batch-run" disabled>开始处理</button>
          <button type="button" data-action="batch-stop" hidden disabled>暂停处理</button>
          <button type="button" data-action="batch-apply" disabled data-primary="true">核对创建清单</button>
        </div>
        <div class="forge-batch-review-actions forge-action-bar-end" hidden>
          <button type="button" data-action="batch-open-editor">在编辑器中打开</button>
          <button type="button" data-action="batch-select-review" data-primary="true" hidden>加入本次创建</button>
        </div>
      </div>
    </div>
  </footer>

  <footer class="forge-workspace-actions forge-action-bar" data-workspace-actions>
    <div class="forge-action-bar-row">
      <div class="forge-action-bar-start">
        <button type="button" data-action="edit-source" data-workspace-action hidden>返回编辑</button>
        <button type="button" data-action="clear" data-workspace-action>清空资料</button>
        <button type="button" data-action="cancel" data-workspace-action hidden disabled>停止处理</button>
        <details class="forge-workspace-more" data-workspace-more>
          <summary>更多操作</summary>
          <div class="forge-workspace-more-actions">
            <button type="button" data-action="library-save" disabled>保存资料</button>
            <button type="button" data-action="restore-candidate" disabled>恢复上次预览</button>
            <button type="button" data-action="download-actor" data-workspace-action hidden>导出角色资料</button>
            <button type="button" data-action="export" data-workspace-action hidden>导出审核记录</button>
            <button type="button" data-action="reject" data-workspace-action hidden>不采用本次结果</button>
          </div>
        </details>
      </div>
      <p class="forge-action-bar-status" data-status tabindex="-1" role="status" aria-live="polite" hidden>等待输入资料</p>
      <div class="forge-action-bar-end">
        <button type="button" data-action="analyze" data-workspace-action data-primary="true">分析资料</button>
        <button type="button" data-action="resume-review" data-workspace-action data-primary="false" hidden>继续查看结果</button>
        <button type="button" data-action="generate" data-workspace-action data-primary="false" hidden>生成预览</button>
        <button type="button" data-action="create" data-workspace-action data-primary="false" hidden>确认创建</button>
        <button type="button" data-action="repair" data-workspace-action data-primary="false" hidden>修正问题</button>
        <button type="button" data-action="regenerate" data-workspace-action data-primary="false" hidden>重新分析</button>
        <button type="button" data-action="open-created" data-workspace-action data-primary="false" hidden>打开已创建条目</button>
        <button type="button" data-action="start-new-attempt" data-workspace-action data-primary="false" hidden>恢复资料</button>
      </div>
    </div>
    <p class="forge-workspace-hint" data-workspace-hint role="status" aria-live="polite"></p>
  </footer>
</section>
