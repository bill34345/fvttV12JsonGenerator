<header class="forge-workspace-navigation" aria-label="Forge 工作台">
  <div class="forge-workspace-navigation-row">
    <div class="forge-workspace-objects" role="group" aria-label="创建对象">
      <button type="button" data-workspace-object="Actor" aria-pressed="false">生物</button>
      {{#if canOpenItems}}
        <button type="button" data-workspace-object="Item" aria-pressed="false">物品</button>
        <button type="button" data-workspace-object="Spell" data-forge-mode="spell" aria-pressed="false">法术</button>
      {{/if}}
    </div>
    <div class="forge-workspace-tools" role="group" aria-label="资料与任务">
      <button type="button" data-workspace-library aria-pressed="false">资料库</button>
      <button type="button" data-workspace-batch aria-pressed="false">批量处理</button>
      <button type="button" data-workspace-encounter>生物与召唤物</button>
      <details class="forge-workspace-menu">
        <summary aria-label="工作台选项"><i class="fas fa-ellipsis" aria-hidden="true"></i></summary>
        <div class="forge-workspace-menu-popover">
          <button type="button" data-workspace-archive hidden>归档位置</button>
          <button type="button" data-workspace-guide>图解手册</button>
        </div>
      </details>
    </div>
  </div>
  <div class="forge-workspace-method-row" data-workspace-method>
    <div class="forge-workspace-modes" role="group" aria-label="资料输入方式">
      <button type="button" data-forge-mode="blueprint" aria-pressed="false">手工蓝图</button>
      <button type="button" data-forge-mode="structured" aria-pressed="false">标准资料</button>
      <button type="button" data-forge-mode="ai" aria-pressed="false">AI 整理</button>
    </div>
    <div class="forge-workspace-tools">
      <span data-workspace-connection-summary role="status" aria-live="polite" hidden></span>
      <button type="button" data-workspace-connection hidden>AI 连接设置</button>
    </div>
  </div>
  <div class="forge-ai-setup" data-workspace-connection-notice hidden>
    <i class="fas fa-plug" aria-hidden="true"></i>
    <p data-workspace-connection-guidance role="status"></p>
    <button type="button" data-workspace-connection>打开连接设置</button>
  </div>
</header>
