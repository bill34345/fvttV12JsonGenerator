<form class="fvtt-json-forge-form forge-connection-panel" data-connection-form>
  <section class="forge-connection-card" aria-labelledby="forge-connection-basics-heading">
    <h3 id="forge-connection-basics-heading">基本连接</h3>
    <div class="forge-connection-grid">
      <label for="forge-connection-provider">Provider
        <select id="forge-connection-provider" name="provider">
          <option value="openai">OpenAI</option>
          <option value="anthropic">Anthropic (Claude)</option>
          <option value="google-gemini">Google Gemini</option>
          <option value="deepseek">DeepSeek</option>
          <option value="xai">xAI (Grok)</option>
          <option value="mistral">Mistral</option>
          <option value="openrouter">OpenRouter</option>
          <option value="alibaba-qwen">Alibaba Qwen</option>
          <option value="moonshot-kimi">Moonshot / Kimi</option>
          <option value="zhipu-glm">Zhipu GLM</option>
          <option value="custom">Custom Provider</option>
        </select>
      </label>
      <div class="forge-model-field" data-model-field>
        <label for="forge-connection-model">模型</label>
        <div class="forge-field-controls forge-model-controls">
          <input id="forge-connection-model" name="model" type="text" role="combobox" aria-autocomplete="list"
            aria-expanded="false" aria-controls="forge-provider-model-options" aria-describedby="forge-model-help"
            autocomplete="off" spellcheck="false" placeholder="选择或输入模型 ID">
          <button type="button" data-action="clear-model" aria-label="清空模型 ID" title="清空模型 ID" disabled>
            <i class="fas fa-xmark" aria-hidden="true"></i>
          </button>
          <button type="button" data-action="show-models" aria-label="选择 Provider 模型" title="选择 Provider 模型"
            aria-expanded="false" aria-controls="forge-provider-model-options">
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
        </div>
        <p class="forge-field-note" id="forge-model-help">输入 API Key 后可查询模型，也可以直接填入模型 ID。</p>
        <div class="forge-model-picker" data-model-picker hidden>
          <div class="forge-model-picker-header">
            <p data-model-status role="status" aria-live="polite"></p>
            <button type="button" data-action="refresh-models">刷新列表</button>
          </div>
          <ul id="forge-provider-model-options" data-model-options role="listbox" aria-label="Provider 模型"></ul>
        </div>
      </div>
      <label for="forge-connection-api-key">API Key
        <span class="forge-field-controls forge-secret-input">
          <input id="forge-connection-api-key" name="apiKey" type="password" autocomplete="off" spellcheck="false" aria-describedby="forge-connection-key-note">
          <button type="button" data-action="toggle-key" aria-label="显示 API Key">显示</button>
        </span>
      </label>
    </div>
    <p id="forge-connection-key-note" class="forge-key-memory-badge" role="status">Key 默认只保留在当前 Foundry 页面；刷新后需要重新输入。</p>
  </section>

  <section class="forge-connection-actions-card">
    <p data-connection-status role="status" aria-live="polite" aria-atomic="true">尚未测试当前连接。</p>
    <div class="forge-connection-actions">
      <a data-provider-docs target="_blank" rel="noreferrer">Provider 文档</a>
      <button type="button" data-action="save">保存配置</button>
      <button type="button" data-action="test-connection">测试连接</button>
    </div>
  </section>

  <details class="forge-advanced-settings">
    <summary>纠错设置</summary>
    <div class="forge-connection-section-body">
      <label class="forge-inline-field" for="forge-connection-auto-correct">
        <input id="forge-connection-auto-correct" name="autoCorrect" type="checkbox" aria-describedby="forge-connection-correction-note">
        开启自动纠错（额外 API 费用）
      </label>
      <p id="forge-connection-correction-note" class="forge-field-note">默认关闭。开启后每只生物最多追加一次请求。纠错失败时仍可查看已有候选和问题提示。</p>
    </div>
  </details>

  <details class="forge-advanced-settings">
    <summary>高级连接设置</summary>
    <div class="forge-advanced-grid">
      <label for="forge-connection-endpoint">HTTPS endpoint
        <span class="forge-field-controls forge-secret-input">
          <input id="forge-connection-endpoint" name="endpoint" type="url" placeholder="https://example.com/v1" aria-describedby="forge-connection-endpoint-note">
          <button type="button" data-action="toggle-endpoint">自定义 endpoint</button>
        </span>
      </label>
      <p id="forge-connection-endpoint-note" class="forge-field-note">必须使用 HTTPS，URL 中不能包含凭据。</p>
      <label for="forge-connection-protocol">API 协议
        <select id="forge-connection-protocol" name="protocol">
          <option value="openai-responses">OpenAI Responses API（流式）</option>
          <option value="openai-chat">OpenAI Chat Completions</option>
          <option value="anthropic-messages">Anthropic Messages</option>
        </select>
      </label>
      <label for="forge-connection-auth">认证方式
        <select id="forge-connection-auth" name="authScheme">
          <option value="bearer">Bearer</option>
          <option value="x-api-key">x-api-key</option>
          <option value="api-key">api-key</option>
          <option value="none">无需认证</option>
        </select>
      </label>
      <label for="forge-connection-region">区域
        <select id="forge-connection-region" name="region"><option value="">默认</option></select>
      </label>
      <label for="forge-connection-reasoning">Reasoning
        <select id="forge-connection-reasoning" name="reasoning"><option value="auto">Auto</option></select>
      </label>
      <label for="forge-connection-structured-output">结构化输出
        <select id="forge-connection-structured-output" name="structuredOutput">
          <option value="json_schema">JSON Schema</option>
          <option value="json_object">JSON Object</option>
          <option value="provider_schema">Provider Schema</option>
          <option value="prompt_fallback">严格 Prompt JSON fallback</option>
        </select>
      </label>
    </div>
  </details>

  <details class="forge-advanced-settings forge-key-settings">
    <summary>API Key 保存与清除</summary>
    <div class="forge-connection-section-body">
      <label class="forge-inline-field" for="forge-connection-persist-key">
        <input id="forge-connection-persist-key" name="persistApiKey" type="checkbox" aria-describedby="forge-persist-note">
        保存 API Key 到当前浏览器
      </label>
      <p id="forge-persist-note" class="forge-field-note">同一 Foundry 站点的其他模块可能读取保存在浏览器中的 Key。</p>
      <div class="forge-secondary-actions">
        <button type="button" data-action="clear-key">清除当前 API Key</button>
        <button type="button" data-action="clear-all-keys">清除全部已保存 Key</button>
      </div>
    </div>
  </details>
</form>
