{{#*inline "listStatusText"}}{{#each statuses}}{{label}}{{#unless @last}}、{{/unless}}{{else}}{{localize "OSD.Actor.NoStatuses"}}{{/each}}{{#if showDeath}}；{{localize "OSD.Actor.DeathSaves"}}：{{localize "OSD.Ledger.Success"}} {{death.success}}，{{localize "OSD.Ledger.Failure"}} {{death.failure}}{{/if}}{{/inline}}
{{#*inline "listStatuses"}}<div class="osd-status-icons osd-ellipsis" data-osd-ellipsis data-label="{{localize 'OSD.Actor.Statuses'}}" title="{{> listStatusText}}" data-tooltip="{{> listStatusText}}"><span class="osd-ellipsis-content osd-status-line">{{#each statuses}}<span class="osd-status-entry" data-status-id="{{id}}" role="img" aria-label="{{label}}" title="{{label}}" data-tooltip="{{label}}">{{#if icon}}<img src="{{icon}}" alt="" aria-hidden="true">{{else}}<i class="fa-solid fa-circle-question" aria-hidden="true"></i>{{/if}}</span>{{else}}<span class="osd-muted">—</span>{{/each}}{{#if showDeath}}<span class="osd-status-entry osd-death-summary" role="img" aria-label="{{localize 'OSD.Actor.DeathSaves'}}：{{localize 'OSD.Ledger.Success'}} {{death.success}}，{{localize 'OSD.Ledger.Failure'}} {{death.failure}}" title="{{localize 'OSD.Actor.DeathSaves'}}：{{localize 'OSD.Ledger.Success'}} {{death.success}}，{{localize 'OSD.Ledger.Failure'}} {{death.failure}}" data-tooltip="{{localize 'OSD.Actor.DeathSaves'}}：{{localize 'OSD.Ledger.Success'}} {{death.success}}，{{localize 'OSD.Ledger.Failure'}} {{death.failure}}"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i></span>{{/if}}</span><span class="osd-ellipsis-marker" aria-hidden="true" hidden>……</span></div>{{/inline}}
{{#*inline "person"}}<button type="button" class="osd-person" data-osd-inspect title="{{name}}{{#if playerNames}} · {{playerNames}}{{/if}}" aria-label="{{localize 'OSD.Selection.Inspect'}} {{name}}"><img class="osd-portrait" src="{{img}}" data-osd-portrait-source="{{portraitSource}}" alt="" decoding="async"><span class="osd-person-info"><strong class="osd-ellipsis" data-osd-ellipsis data-osd-name="{{name}}"><span class="osd-ellipsis-content">{{name}}</span><span class="osd-ellipsis-marker" aria-hidden="true" hidden>……</span></strong>{{#if showResources}}<span class="osd-party-resources">{{#if characterControls}}<span class="osd-resource osd-inspiration {{#if inspiration}}active{{/if}}" data-osd-inspiration="{{#if inspiration}}true{{else}}false{{/if}}" role="img" aria-label="{{#if inspiration}}{{localize 'OSD.Actor.HasHeroicInspiration'}}{{else}}{{localize 'OSD.Actor.NoHeroicInspiration'}}{{/if}}" title="{{#if inspiration}}{{localize 'OSD.Actor.HasHeroicInspiration'}}{{else}}{{localize 'OSD.Actor.NoHeroicInspiration'}}{{/if}}" data-tooltip="{{#if inspiration}}{{localize 'OSD.Actor.HasHeroicInspiration'}}{{else}}{{localize 'OSD.Actor.NoHeroicInspiration'}}{{/if}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i><span aria-hidden="true">{{#if inspiration}}✓{{else}}—{{/if}}</span></span>{{/if}}<span class="osd-resource osd-exhaustion {{#if exhaustion}}active{{/if}}" data-osd-exhaustion="{{exhaustion}}" role="img" aria-label="{{localize 'OSD.Actor.Exhaustion'}}：{{exhaustion}}" title="{{localize 'OSD.Actor.Exhaustion'}}：{{exhaustion}}" data-tooltip="{{localize 'OSD.Actor.Exhaustion'}}：{{exhaustion}}"><i class="fa-solid fa-person-hiking" aria-hidden="true"></i><span class="osd-resource-value" aria-hidden="true">{{exhaustion}}</span></span></span>{{/if}}</span></button>{{/inline}}
{{#*inline "inspection"}}<aside class="osd-inspection" data-osd-inspection popover="auto" aria-label="{{localize 'OSD.Selection.Inspect'}} {{name}}"><header><img class="osd-portrait" src="{{img}}" alt=""><strong title="{{name}}">{{localize "OSD.Selection.Inspect"}}：{{name}}</strong><small data-osd-inspection-selected>{{localize "OSD.Selection.Unchecked"}}</small></header><dl class="osd-inspection-vitals"><dt>{{localize "OSD.Ledger.HP"}}</dt><dd>{{hp.value}} / {{hp.effectiveMax}}{{#if hp.temp}} +{{hp.temp}}{{/if}}</dd><dt>{{localize "OSD.Actor.AC"}}</dt><dd>{{#if ac}}{{ac}}{{else}}—{{/if}}</dd></dl><div class="osd-inspection-summary"><span>{{localize "OSD.Actor.BaseMax"}} <output data-label="{{localize 'OSD.Actor.BaseMax'}}">{{hp.baseMax}}</output></span><span>{{localize "OSD.Actor.MaxModifier"}} <output data-label="{{localize 'OSD.Actor.MaxModifier'}}">{{hp.maxModifierDisplay}}</output></span><span>{{localize "OSD.Actor.ACModifier"}} <output data-label="{{localize 'OSD.Actor.ACModifier'}}">{{acModifier}}</output></span></div><div class="osd-inspection-status"><span>{{localize "OSD.Ledger.Statuses"}}</span>{{> listStatuses}}</div>{{#if death}}<p>{{localize "OSD.Actor.DeathSaves"}}：{{localize "OSD.Ledger.Success"}} {{death.success}} · {{localize "OSD.Ledger.Failure"}} {{death.failure}}</p>{{/if}}<footer><button type="button" data-osd-command="actor.open-sheet" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.openSheet.tooltipKey}}" data-tooltip="{{commands.openSheet.tooltipKey}}" {{#unless commands.openSheet.enabled}}disabled{{/unless}}><i class="fa-solid fa-id-card" aria-hidden="true"></i>{{localize "OSD.Actions.OpenSheet"}}</button><button type="button" data-osd-command="token.locate" data-token-uuid="{{tokenUuid}}" data-busy-key="{{tokenUuid}}" title="{{localize commands.locate.tooltipKey}}" data-tooltip="{{commands.locate.tooltipKey}}" {{#unless commands.locate.enabled}}disabled{{/unless}}><i class="fa-solid fa-location-dot" aria-hidden="true"></i>{{localize "OSD.Selection.Locate"}}</button></footer></aside>{{/inline}}
<section class="osd-deck {{#if compact}}osd-compact{{/if}}" data-osd-deck>
  <header class="osd-header"><div class="osd-heading"><h1>{{localize "OSD.Ledger.Title"}}</h1><p>{{world.title}}</p></div><div class="osd-header-actions"><button type="button" data-osd-action="undo" data-osd-undo-count="{{undo.count}}" data-busy-key="undo" aria-label="{{localize 'OSD.Actions.Undo'}}" title="{{#if undo.reason}}{{undo.reason}}{{else}}{{#if undo.count}}{{localize 'OSD.Actions.Undo'}}: {{undo.label}}{{else}}{{localize 'OSD.Undo.Empty'}}{{/if}}{{/if}}" {{#unless undo.available}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>{{localize "OSD.Actions.Undo"}}</button>
    <button type="button" data-osd-action="open-layer" data-target-layer="folder" aria-label="{{localize 'OSD.Actions.PartyFolder'}}"><i class="fa-solid fa-user-group" aria-hidden="true"></i>{{localize "OSD.Ledger.PartySource"}}</button>
    <button type="button" data-osd-action="toggle-density" aria-label="{{localize 'OSD.Actions.Density'}}：{{#if compact}}{{localize 'OSD.Density.Compact'}}{{else}}{{localize 'OSD.Density.Comfortable'}}{{/if}}" title="{{localize 'OSD.Actions.ToggleDensity'}}"><i class="fa-solid fa-layer-group" aria-hidden="true"></i>{{localize "OSD.Actions.Density"}}</button>
    <button type="button" data-osd-action="open-help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i>{{localize "OSD.Actions.Help"}}</button>
    {{#if isPopout}}<button type="button" data-osd-action="open-panel" aria-label="{{localize 'OSD.Actions.OpenPanel'}}" title="{{localize 'OSD.Actions.OpenPanel'}}" data-tooltip="OSD.Actions.OpenPanel"><i class="fa-solid fa-window-restore" aria-hidden="true"></i>{{localize "OSD.Ledger.Panel"}}</button><button type="button" class="osd-popout-close" data-osd-action="close-popout" aria-label="{{localize 'OSD.Actions.ClosePopout'}}" title="{{localize 'OSD.Actions.ClosePopout'}}" data-tooltip="OSD.Actions.ClosePopout"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{else}}<button type="button" data-osd-action="open-popout" aria-label="{{localize 'OSD.Actions.OpenPopout'}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>{{localize "OSD.Ledger.Popout"}}</button>{{/if}}
  </div></header>
  <div class="osd-binding" aria-hidden="true"><span></span><span></span><span></span></div>
  {{#unless supported}}<div class="osd-banner osd-error" role="alert"><strong>{{localize "OSD.Errors.Unsupported"}}</strong> {{supportError}}</div>{{/unless}}
  {{#if error}}<div class="osd-banner osd-error" role="alert">{{error}}</div>{{/if}}
  {{#if partyFolder.missing}}<div class="osd-banner osd-error" role="alert">{{localize "OSD.Errors.PartyFolderMissing"}}</div>{{/if}}
  <nav class="osd-tabs" aria-label="{{localize 'OSD.Tabs.Label'}}"><button type="button" class="{{#if partyTabActive}}active{{/if}}" data-osd-action="party-tab">{{localize "OSD.Party.Title"}} {{party.length}}</button><button type="button" class="{{#if encounterTabActive}}active{{/if}}" data-osd-action="encounter-tab">{{localize "OSD.Encounter.Title"}} {{encounter.combatants.length}}</button></nav>
  <div class="osd-columns" data-active-tab="{{activeTab}}">
    <section class="osd-column osd-party-column" aria-labelledby="osd-party-title">
      <div class="osd-section-heading"><h2 id="osd-party-title"><i class="fa-solid fa-users" aria-hidden="true"></i>{{localize "OSD.Party.Title"}} · {{party.length}}{{localize "OSD.Ledger.Members"}}</h2><button type="button" class="osd-quiet-button" data-osd-select-all-party title="{{localize 'OSD.Batch.SelectAll'}}"><i class="fa-solid fa-sliders" aria-hidden="true"></i>{{localize "OSD.Actions.Batch"}}</button></div>
      {{#if hasParty}}<div class="osd-roster" role="list"><div class="osd-party-grid osd-grid-header"><input type="checkbox" data-osd-select-scope="party" aria-label="{{localize 'OSD.Batch.SelectAll'}}"><span>{{localize "OSD.Actor.Identity"}}</span><span>{{localize "OSD.Ledger.HP"}}</span><span>{{localize "OSD.Ledger.AC"}}</span><span>{{localize "OSD.Ledger.Statuses"}}</span></div>
      {{#each party}}<article class="osd-party-row" data-osd-party-row="{{uuid}}" data-osd-target-row role="listitem"><div class="osd-party-grid osd-row-primary">
        <input type="checkbox" data-osd-select-target data-osd-scope="party" value="{{#if selectionKey}}{{selectionKey}}{{else}}actor:{{uuid}}{{/if}}" aria-label="{{localize 'OSD.Selection.Select'}} {{name}}">
        {{> person showResources=true}}
        <label class="osd-hp-readout" title="{{localize commands.setHp.tooltipKey}} · {{hp.value}} / {{hp.effectiveMax}}{{#if hp.temp}} · {{localize 'OSD.Actor.TempHP'}} +{{hp.temp}}{{/if}}" data-tooltip="{{commands.setHp.tooltipKey}}"><span class="osd-sr-only osd-stat-label">{{localize "OSD.Actor.CurrentHP"}}</span><input type="number" min="0" max="{{hp.effectiveMax}}" value="{{hp.value}}" data-osd-direct-command="actor.set-hp" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setHp.tooltipKey}}" data-tooltip="{{commands.setHp.tooltipKey}}" {{#unless commands.setHp.enabled}}disabled{{/unless}}><span>/ {{hp.effectiveMax}}</span>{{#if hp.temp}}<small>+{{hp.temp}}</small>{{/if}}</label><output title="{{localize 'OSD.Actor.AC'}}：{{#if ac}}{{ac}}{{else}}—{{/if}}">{{#if ac}}{{ac}}{{else}}—{{/if}}</output>{{> listStatuses}}
      </div>{{> inspection}}</article>{{/each}}</div>{{else}}<div class="osd-empty"><i class="fa-solid fa-users" aria-hidden="true"></i><p>{{#if partyFolder.selectedId}}{{localize "OSD.Party.EmptyFolder"}}{{else}}{{localize "OSD.Party.Empty"}}{{/if}}</p><button type="button" data-osd-action="open-layer" data-target-layer="folder">{{localize "OSD.Actions.ChoosePartyFolder"}}</button></div>{{/if}}
    </section>
    <div class="osd-column-resizer" data-osd-column-resizer data-keyboard-focus role="separator" tabindex="0" aria-orientation="vertical" aria-label="{{localize 'OSD.Layout.Separator'}}" title="{{localize 'OSD.Layout.ResizeHint'}}"></div>
    <section class="osd-column osd-encounter-column" aria-labelledby="osd-encounter-title">
      <div class="osd-round-strip"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>{{#if encounter.active}}<strong>{{localize "OSD.Encounter.Round"}} {{encounter.round}}</strong><span>·</span><b class="osd-ellipsis" data-osd-ellipsis data-osd-name="{{localize "OSD.Encounter.CurrentAction"}}：{{#if currentCombatant}}{{currentCombatant.name}}{{else}}—{{/if}}" title="{{localize "OSD.Encounter.CurrentAction"}}：{{#if currentCombatant}}{{currentCombatant.name}}{{else}}—{{/if}}"><span class="osd-ellipsis-content">{{localize "OSD.Encounter.CurrentAction"}}：{{#if currentCombatant}}{{currentCombatant.name}}{{else}}—{{/if}}</span><span class="osd-ellipsis-marker" aria-hidden="true" hidden>……</span></b>{{else}}<span>{{localize "OSD.Encounter.Inactive"}}</span>{{/if}}</div>
      <div class="osd-section-heading osd-encounter-heading"><h2 id="osd-encounter-title"><i class="fa-solid fa-user-group" aria-hidden="true"></i>{{localize "OSD.Encounter.Title"}} · {{localize "OSD.Ledger.Initiative"}}</h2><div class="osd-turn-buttons"><button type="button" data-osd-command="combat.previous-turn" data-combat-uuid="{{encounter.uuid}}" data-busy-key="{{encounter.uuid}}" {{#unless encounter.commands.previousTurn.enabled}}disabled{{/unless}} title="{{localize encounter.commands.previousTurn.tooltipKey}}" data-tooltip="{{encounter.commands.previousTurn.tooltipKey}}" aria-label="{{localize encounter.commands.previousTurn.tooltipKey}}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i>{{localize "OSD.Actions.PreviousTurn"}}</button><button type="button" class="osd-primary-button" data-osd-command="combat.next-turn" data-combat-uuid="{{encounter.uuid}}" data-busy-key="{{encounter.uuid}}" {{#unless encounter.commands.nextTurn.enabled}}disabled{{/unless}} title="{{localize encounter.commands.nextTurn.tooltipKey}}" data-tooltip="{{encounter.commands.nextTurn.tooltipKey}}" aria-label="{{localize encounter.commands.nextTurn.tooltipKey}}">{{localize "OSD.Actions.NextTurn"}}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button></div></div>
      <div class="osd-encounter-toolbar"><button type="button" class="osd-quiet-button" data-osd-action="focus-current" {{#unless encounter.commands.focusCurrent.enabled}}disabled{{/unless}} title="{{localize encounter.commands.focusCurrent.tooltipKey}}" data-tooltip="{{encounter.commands.focusCurrent.tooltipKey}}" aria-label="{{localize encounter.commands.focusCurrent.tooltipKey}}"><i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>{{localize "OSD.Actions.FocusCurrent"}}</button><div class="osd-encounter-shortcuts"><button type="button" class="osd-combat-icon" data-osd-action="open-layer" data-target-layer="swap" {{#unless encounter.commands.swapInitiative.enabled}}disabled{{/unless}} title="{{localize encounter.commands.swapInitiative.tooltipKey}}" data-tooltip="{{encounter.commands.swapInitiative.tooltipKey}}" aria-label="{{localize 'OSD.Actions.SwapInitiative'}}"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i></button><button type="button" class="osd-combat-icon" data-osd-command="combat.roll-npc-initiative" data-combat-uuid="{{encounter.uuid}}" data-busy-key="{{encounter.uuid}}" {{#unless encounter.commands.rollNpcInitiative.enabled}}disabled{{/unless}} title="{{localize encounter.commands.rollNpcInitiative.tooltipKey}}" data-tooltip="{{encounter.commands.rollNpcInitiative.tooltipKey}}" aria-label="{{localize 'OSD.Actions.RollNpcInitiative'}}"><i class="fa-solid fa-users-cog" aria-hidden="true"></i></button></div></div>
      {{#if hasEncounterCards}}<div class="osd-encounter-list" role="list"><div class="osd-queue-header"><input type="checkbox" data-osd-select-scope="encounter" aria-label="{{localize 'OSD.Selection.SelectEncounter'}}"><span>{{localize "OSD.Encounter.Initiative"}}</span><span>{{localize "OSD.Actor.Identity"}}</span><span>{{localize "OSD.Ledger.HP"}}</span><span>{{localize "OSD.Ledger.Statuses"}}</span></div>
      {{#each encounter.combatants}}<article class="{{#if partyMember}}osd-combatant-placeholder{{else}}osd-npc-row{{/if}} {{#if current}}current{{/if}}" data-osd-combatant-row="{{combatantId}}" data-current="{{current}}" data-defeated="{{defeated}}" data-combatant-id="{{combatantId}}" data-osd-target-row role="listitem"><div class="osd-queue-row"><input type="checkbox" data-osd-select-target data-osd-scope="encounter" value="combatant:{{combatantId}}" aria-label="{{localize 'OSD.Selection.Select'}} {{name}}"><div class="osd-initiative-cell">{{#if current}}<i class="fa-solid fa-caret-right osd-current-marker" aria-hidden="true"></i>{{/if}}{{#if hasInitiative}}<label title="{{localize commands.setInitiative.tooltipKey}}" data-tooltip="{{commands.setInitiative.tooltipKey}}"><span class="osd-sr-only">{{localize "OSD.Encounter.Initiative"}}</span><input type="number" step="0.01" value="{{initiative}}" data-osd-direct-command="combat.set-initiative" data-combat-uuid="{{../encounter.uuid}}" data-combatant-id="{{combatantId}}" data-busy-key="{{../encounter.uuid}}" title="{{localize commands.setInitiative.tooltipKey}}" data-tooltip="{{commands.setInitiative.tooltipKey}}" {{#unless commands.setInitiative.enabled}}disabled{{/unless}}></label>{{else}}<button type="button" class="osd-roll-initiative" data-osd-command="combat.roll-initiative" data-combat-uuid="{{../encounter.uuid}}" data-combatant-id="{{combatantId}}" data-busy-key="{{../encounter.uuid}}" {{#unless commands.rollInitiative.enabled}}disabled{{/unless}} title="{{localize commands.rollInitiative.tooltipKey}}" data-tooltip="{{commands.rollInitiative.tooltipKey}}" aria-label="{{localize 'OSD.Actions.RollInitiative'}} · {{name}}">{{#if @root.initiativeIcon.icon}}<i class="osd-native-d20" style="--osd-initiative-icon: url('{{@root.initiativeIcon.icon}}')" aria-hidden="true"></i>{{else}}<i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{/if}}</button>{{/if}}</div><div class="osd-combatant-identity">{{> person}}<button type="button" class="osd-combat-icon osd-visibility {{#if hidden}}active{{/if}}" data-osd-command="combat.toggle-visibility" data-combat-uuid="{{../encounter.uuid}}" data-combatant-id="{{combatantId}}" data-busy-key="{{../encounter.uuid}}" {{#unless commands.toggleVisibility.enabled}}disabled{{/unless}} aria-pressed="{{#if hidden}}true{{else}}false{{/if}}" title="{{#unless commands.toggleVisibility.enabled}}{{localize commands.toggleVisibility.tooltipKey}}{{else}}{{#if hidden}}{{localize 'OSD.Actions.ShowCombatant'}}{{else}}{{localize 'OSD.Actions.HideCombatant'}}{{/if}}{{/unless}}" data-tooltip="{{#if hidden}}OSD.Actions.ShowCombatant{{else}}OSD.Actions.HideCombatant{{/if}}" aria-label="{{#if hidden}}{{localize 'OSD.Actions.ShowCombatant'}}{{else}}{{localize 'OSD.Actions.HideCombatant'}}{{/if}} · {{name}}"><i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i></button></div><span class="osd-queue-hp" title="{{hp.value}} / {{hp.effectiveMax}}">{{hp.value}} / {{hp.effectiveMax}}</span>{{> listStatuses}}</div>{{> inspection}}</article>{{/each}}</div>{{else}}<div class="osd-empty"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i><p>{{localize "OSD.Encounter.Empty"}}</p></div>{{/if}}
    </section>
  </div>
  <section class="osd-operations" data-osd-operations aria-label="{{localize 'OSD.Actions.Batch'}}" hidden>
    <div class="osd-selection-bar"><strong data-osd-selection-count></strong><div class="osd-selected-tags" data-osd-selected-tags><div class="osd-tag-track" data-osd-tag-track></div><details class="osd-operation-menu osd-selection-overflow" data-osd-selection-overflow hidden><summary>+0</summary><div class="osd-command-menu osd-selected-list" data-osd-selected-list></div></details><button type="button" data-osd-clear-selection>{{localize "OSD.Selection.Clear"}}</button></div><button type="button" class="osd-footer-undo" data-osd-action="undo" data-busy-key="undo" title="{{undo.label}}" {{#unless undo.available}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>{{localize "OSD.Selection.UndoLast"}}</button></div>
