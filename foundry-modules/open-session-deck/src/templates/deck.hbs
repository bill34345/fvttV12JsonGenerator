<section class="osd-deck {{#if compact}}osd-compact{{/if}}" data-osd-deck>
  <header class="osd-header">
    <div class="osd-heading"><h1>Open Session Deck</h1><p>{{world.title}}{{#if scene}} · {{scene.name}}{{/if}}</p><p class="osd-runtime" data-osd-runtime>{{localize "OSD.Runtime.Current"}}: Core {{#if coreVersion}}{{coreVersion}}{{else}}—{{/if}} · {{#if system.id}}{{system.id}}{{else}}—{{/if}} {{#if system.version}}{{system.version}}{{else}}—{{/if}} · {{#if supported}}{{localize "OSD.Runtime.Supported"}}{{else}}{{localize "OSD.Runtime.Unsupported"}}{{/if}}</p></div>
    <div class="osd-turn-heading">{{#if encounter.active}}<strong>{{localize "OSD.Encounter.Round"}} {{encounter.round}}</strong><span>·</span><b>{{localize "OSD.Encounter.CurrentAction"}}：{{#if currentCombatant}}{{currentCombatant.name}}{{else}}—{{/if}}</b>{{else}}<span>{{localize "OSD.Encounter.Inactive"}}</span>{{/if}}</div>
    <div class="osd-header-actions">
      <button type="button" data-osd-action="open-layer" data-target-layer="batch"><i class="fa-solid fa-sliders" aria-hidden="true"></i>{{localize "OSD.Actions.Batch"}}</button>
      <button type="button" data-osd-action="open-layer" data-target-layer="folder"><i class="fa-solid fa-folder" aria-hidden="true"></i>{{localize "OSD.Actions.PartyFolder"}}</button>
      <button type="button" data-osd-action="toggle-density" title="{{localize 'OSD.Actions.ToggleDensity'}}"><i class="fa-solid fa-table-cells" aria-hidden="true"></i>{{localize "OSD.Actions.Density"}}：{{#if compact}}{{localize "OSD.Density.Compact"}}{{else}}{{localize "OSD.Density.Comfortable"}}{{/if}}</button>
      <button type="button" data-osd-action="open-help"><i class="fa-solid fa-circle-question" aria-hidden="true"></i>{{localize "OSD.Actions.Help"}}</button>
      {{#if isPopout}}<button type="button" data-osd-action="open-panel"><i class="fa-solid fa-window-restore" aria-hidden="true"></i>{{localize "OSD.Actions.OpenPanel"}}</button><button type="button" data-osd-action="close-popout"><i class="fa-solid fa-xmark" aria-hidden="true"></i>{{localize "OSD.Actions.ClosePopout"}}</button>{{else}}<button type="button" data-osd-action="open-popout"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>{{localize "OSD.Actions.OpenPopout"}}</button>{{/if}}
    </div>
  </header>

  {{#unless supported}}<div class="osd-banner osd-error" role="alert"><strong>{{localize "OSD.Errors.Unsupported"}}</strong> {{supportError}}</div>{{/unless}}
  {{#if error}}<div class="osd-banner osd-error" role="alert">{{error}}</div>{{/if}}
  {{#if partyFolder.missing}}<div class="osd-banner osd-error" role="alert">{{localize "OSD.Errors.PartyFolderMissing"}}</div>{{/if}}

  <nav class="osd-tabs" aria-label="{{localize 'OSD.Tabs.Label'}}"><button type="button" class="{{#if partyTabActive}}active{{/if}}" data-osd-action="party-tab">{{localize "OSD.Party.Title"}} <span>{{party.length}}</span></button><button type="button" class="{{#if encounterTabActive}}active{{/if}}" data-osd-action="encounter-tab">{{localize "OSD.Encounter.Title"}} <span>{{encounter.combatants.length}}</span></button></nav>

  <div class="osd-columns" data-active-tab="{{activeTab}}">
    <section class="osd-column osd-party-column" aria-labelledby="osd-party-title">
      <div class="osd-section-heading"><div><h2 id="osd-party-title">{{localize "OSD.Party.Title"}}（{{party.length}}）</h2><p>{{#if partyFolder.selectedName}}{{partyFolder.selectedName}}{{else}}{{localize "OSD.Party.NoFolder"}}{{/if}}</p></div></div>
      <div class="osd-party-grid osd-grid-header" aria-hidden="true"><span class="osd-col-identity">{{localize "OSD.Actor.Identity"}}</span><span>{{localize "OSD.Actor.CurrentHP"}}</span><span>{{localize "OSD.Actor.BaseMax"}}</span><span>{{localize "OSD.Actor.MaxModifier"}}</span><span>{{localize "OSD.Actor.EffectiveMax"}}</span><span>{{localize "OSD.Actor.TempHP"}}</span><span>{{localize "OSD.Actor.AC"}}</span><span>{{localize "OSD.Actor.Statuses"}}</span></div>

      {{#if hasParty}}
        <div class="osd-roster" role="list">
          {{#each party}}
            <article class="osd-party-row {{#if inCombat}}in-combat{{/if}}" data-actor-card data-actor-uuid="{{uuid}}" role="listitem">
              <div class="osd-party-grid osd-row-primary">
                <div class="osd-person"><img class="osd-portrait" src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{type}}{{#if playerNames}} · {{playerNames}}{{/if}}</small></span></div>
                <label title="{{localize commands.setHp.tooltipKey}}" data-tooltip="{{commands.setHp.tooltipKey}}"><span class="osd-sr-only">{{localize "OSD.Actor.CurrentHP"}}</span><input type="number" min="0" max="{{hp.effectiveMax}}" step="1" value="{{hp.value}}" data-osd-direct-command="actor.set-hp" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setHp.tooltipKey}}" data-tooltip="{{commands.setHp.tooltipKey}}" {{#unless commands.setHp.enabled}}disabled{{/unless}}></label>
                <output>{{hp.baseMax}}</output>
                <label title="{{localize commands.setMaxModifier.tooltipKey}}" data-tooltip="{{commands.setMaxModifier.tooltipKey}}"><span class="osd-sr-only">{{localize "OSD.Actor.MaxModifier"}}</span><input class="osd-signed" type="text" inputmode="numeric" pattern="[+-]?[0-9]+" value="{{hp.maxModifierDisplay}}" data-osd-direct-command="actor.set-max-modifier" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setMaxModifier.tooltipKey}}" data-tooltip="{{commands.setMaxModifier.tooltipKey}}" {{#unless commands.setMaxModifier.enabled}}disabled{{/unless}}></label>
                <output>{{hp.effectiveMax}}</output>
                <label title="{{localize commands.setTempHp.tooltipKey}}" data-tooltip="{{commands.setTempHp.tooltipKey}}"><span class="osd-sr-only">{{localize "OSD.Actor.TempHP"}}</span><input type="number" min="0" step="1" value="{{hp.temp}}" data-osd-direct-command="actor.set-temp-hp" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setTempHp.tooltipKey}}" data-tooltip="{{commands.setTempHp.tooltipKey}}" {{#unless commands.setTempHp.enabled}}disabled{{/unless}}></label>
                <output>{{#if ac}}{{ac}}{{else}}—{{/if}}</output>
                <div class="osd-status-icons">{{#each statuses}}{{#if icon}}<img src="{{icon}}" alt="{{label}}" title="{{label}}">{{else}}<span>{{label}}</span>{{/if}}{{else}}<small>—</small>{{/each}}</div>
              </div>
              <div class="osd-hp-meter" role="meter" aria-valuemin="0" aria-valuemax="{{hp.effectiveMax}}" aria-valuenow="{{hp.value}}"><span style="width:{{hp.percent}}%"></span></div>
              <div class="osd-row-secondary">
                <button type="button" data-osd-command="actor.toggle-inspiration" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" {{#unless commands.toggleInspiration.enabled}}disabled{{/unless}}>{{#if inspiration}}{{localize "OSD.Actions.RemoveInspiration"}}{{else}}{{localize "OSD.Actions.GainInspiration"}}{{/if}}</button>
                <div class="osd-stepper"><span>{{localize "OSD.Actor.Exhaustion"}}</span><button type="button" data-osd-command="actor.adjust-exhaustion" data-target-uuid="{{uuid}}" data-delta="-1" data-busy-key="{{uuid}}" {{#unless commands.exhaustionDown.enabled}}disabled{{/unless}} title="{{localize commands.exhaustionDown.tooltipKey}}" data-tooltip="{{commands.exhaustionDown.tooltipKey}}" aria-label="{{localize commands.exhaustionDown.tooltipKey}}">−</button><output>{{exhaustion}}</output><button type="button" data-osd-command="actor.adjust-exhaustion" data-target-uuid="{{uuid}}" data-delta="1" data-busy-key="{{uuid}}" {{#unless commands.exhaustionUp.enabled}}disabled{{/unless}} title="{{localize commands.exhaustionUp.tooltipKey}}" data-tooltip="{{commands.exhaustionUp.tooltipKey}}" aria-label="{{localize commands.exhaustionUp.tooltipKey}}">+</button></div>
                <details class="osd-status-picker" data-osd-preserve-key="status:{{uuid}}"><summary>{{localize "OSD.Actions.Status"}} {{statuses.length}}</summary><div class="osd-status-menu">{{#each statusChoices}}<label><input type="checkbox" data-osd-status-choice data-target-uuid="{{../uuid}}" data-status-id="{{id}}" {{#if active}}checked{{/if}} {{#unless ../commands.toggleStatus.enabled}}disabled{{/unless}}><span>{{#if icon}}<img src="{{icon}}" alt="">{{/if}}{{label}}</span></label>{{/each}}</div></details>
                <label class="osd-inline-field" title="{{localize commands.setAcModifier.tooltipKey}}" data-tooltip="{{commands.setAcModifier.tooltipKey}}"><span>{{localize "OSD.Actor.ACModifier"}}</span><input type="number" step="1" value="{{acModifier}}" data-osd-direct-command="actor.set-ac-modifier" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setAcModifier.tooltipKey}}" data-tooltip="{{commands.setAcModifier.tooltipKey}}" {{#unless commands.setAcModifier.enabled}}disabled{{/unless}}></label>
                <button type="button" class="{{#if concentrating}}active{{/if}}" data-osd-command="actor.toggle-concentration" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" {{#if concentrating}}data-confirm="{{localize 'OSD.Confirm.EndConcentration'}}"{{/if}} {{#unless commands.toggleConcentration.enabled}}disabled{{/unless}}>{{#if concentrating}}{{localize "OSD.Actions.EndConcentration"}}{{else}}{{localize "OSD.Actions.StartConcentration"}}{{/if}}</button>
                {{#if death}}<div class="osd-death" data-osd-death-current-success="{{death.success}}" data-osd-death-current-failure="{{death.failure}}"><span>{{localize "OSD.Actor.DeathSaves"}}</span><span class="osd-pips osd-pips-success"><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="success" data-value="1" aria-label="1" {{#unless commands.setDeathSave.enabled}}disabled{{/unless}}></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="success" data-value="2" aria-label="2" {{#unless commands.setDeathSave.enabled}}disabled{{/unless}}></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="success" data-value="3" aria-label="3" {{#unless commands.setDeathSave.enabled}}disabled{{/unless}}></button></span><span class="osd-pips osd-pips-failure"><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="failure" data-value="1" aria-label="1" {{#unless commands.setDeathSave.enabled}}disabled{{/unless}}></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="failure" data-value="2" aria-label="2" {{#unless commands.setDeathSave.enabled}}disabled{{/unless}}></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="failure" data-value="3" aria-label="3" {{#unless commands.setDeathSave.enabled}}disabled{{/unless}}></button></span></div>{{/if}}
                <button type="button" class="osd-icon-button" data-osd-command="actor.open-sheet" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.openSheet.tooltipKey}}" data-tooltip="{{commands.openSheet.tooltipKey}}" {{#unless commands.openSheet.enabled}}disabled{{/unless}}><i class="fa-solid fa-id-card" aria-hidden="true"></i><span class="osd-sr-only">{{localize "OSD.Actions.OpenSheet"}}</span></button>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}<div class="osd-empty"><i class="fa-solid fa-user-group" aria-hidden="true"></i><p>{{#if partyFolder.selectedId}}{{localize "OSD.Party.EmptyFolder"}}{{else}}{{localize "OSD.Party.Empty"}}{{/if}}</p><button type="button" data-osd-action="open-layer" data-target-layer="folder">{{localize "OSD.Actions.ChoosePartyFolder"}}</button></div>{{/if}}
    </section>

    <section class="osd-column osd-encounter-column" aria-labelledby="osd-encounter-title">
      <div class="osd-section-heading osd-encounter-heading"><div><h2 id="osd-encounter-title">{{localize "OSD.Encounter.Title"}}</h2><p>{{localize "OSD.Encounter.InitiativeHint"}}</p></div><div class="osd-encounter-actions"><button type="button" data-osd-action="open-layer" data-target-layer="swap" {{#unless encounter.commands.swapInitiative.enabled}}disabled{{/unless}}><i class="fa-solid fa-right-left" aria-hidden="true"></i>{{localize "OSD.Actions.SwapInitiative"}}</button><button type="button" data-osd-command="combat.roll-npc-initiative" data-combat-uuid="{{encounter.uuid}}" data-busy-key="{{encounter.uuid}}" {{#unless encounter.commands.rollNpcInitiative.enabled}}disabled{{/unless}}><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{localize "OSD.Actions.RollNpcInitiative"}}</button></div></div>
      <div class="osd-current-strip {{#unless hasCurrentCombatant}}inactive{{/unless}}"><button type="button" class="osd-current-arrow" data-osd-action="focus-current" {{#unless encounter.commands.focusCurrent.enabled}}disabled{{/unless}} title="{{localize encounter.commands.focusCurrent.tooltipKey}}" data-tooltip="{{encounter.commands.focusCurrent.tooltipKey}}" aria-label="{{localize encounter.commands.focusCurrent.tooltipKey}}"><i class="fa-solid fa-play" aria-hidden="true"></i></button>{{#if currentCombatant}}<img src="{{currentCombatant.img}}" alt=""><span><small>{{localize "OSD.Encounter.CurrentAction"}}</small><strong>{{currentCombatant.name}} · {{#if currentCombatant.hasInitiative}}{{currentCombatant.initiative}}{{else}}—{{/if}}</strong></span>{{else}}<span><small>{{localize "OSD.Encounter.CurrentAction"}}</small><strong>—</strong></span>{{/if}}<div><button type="button" data-osd-command="combat.previous-turn" data-combat-uuid="{{encounter.uuid}}" data-busy-key="{{encounter.uuid}}" {{#unless encounter.commands.previousTurn.enabled}}disabled{{/unless}} title="{{localize encounter.commands.previousTurn.tooltipKey}}" data-tooltip="{{encounter.commands.previousTurn.tooltipKey}}" aria-label="{{localize encounter.commands.previousTurn.tooltipKey}}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i>{{localize "OSD.Actions.PreviousTurn"}}</button><button type="button" data-osd-command="combat.next-turn" data-combat-uuid="{{encounter.uuid}}" data-busy-key="{{encounter.uuid}}" {{#unless encounter.commands.nextTurn.enabled}}disabled{{/unless}} title="{{localize encounter.commands.nextTurn.tooltipKey}}" data-tooltip="{{encounter.commands.nextTurn.tooltipKey}}" aria-label="{{localize encounter.commands.nextTurn.tooltipKey}}">{{localize "OSD.Actions.NextTurn"}}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button></div></div>

      {{#if hasEncounterCards}}
        <div class="osd-encounter-list" role="list">
          {{#each encounter.combatants}}
            {{#if partyMember}}
              <article class="osd-combatant-placeholder {{#if current}}current{{/if}}" data-current="{{current}}" data-combatant-id="{{combatantId}}" role="listitem"><label title="{{localize commands.setInitiative.tooltipKey}}" data-tooltip="{{commands.setInitiative.tooltipKey}}"><span class="osd-sr-only">{{localize "OSD.Encounter.Initiative"}}</span><input type="number" step="0.01" value="{{initiative}}" data-osd-direct-command="combat.set-initiative" data-combat-uuid="{{../encounter.uuid}}" data-combatant-id="{{combatantId}}" data-busy-key="{{../encounter.uuid}}" title="{{localize commands.setInitiative.tooltipKey}}" data-tooltip="{{commands.setInitiative.tooltipKey}}" {{#unless commands.setInitiative.enabled}}disabled{{/unless}}></label><img src="{{img}}" alt=""><span><strong>{{name}}</strong><small>{{type}}</small></span><button type="button" class="osd-icon-button" data-osd-command="token.locate" data-token-uuid="{{tokenUuid}}" data-busy-key="{{tokenUuid}}" {{#unless commands.locate.enabled}}disabled{{/unless}} title="{{localize commands.locate.tooltipKey}}"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button></article>
            {{else}}
              <article class="osd-npc-row {{#if current}}current{{/if}}" data-actor-card data-current="{{current}}" data-combatant-id="{{combatantId}}" role="listitem">
                <div class="osd-npc-primary"><label title="{{localize commands.setInitiative.tooltipKey}}" data-tooltip="{{commands.setInitiative.tooltipKey}}"><span class="osd-sr-only">{{localize "OSD.Encounter.Initiative"}}</span><input type="number" step="0.01" value="{{initiative}}" data-osd-direct-command="combat.set-initiative" data-combat-uuid="{{../encounter.uuid}}" data-combatant-id="{{combatantId}}" data-busy-key="{{../encounter.uuid}}" title="{{localize commands.setInitiative.tooltipKey}}" data-tooltip="{{commands.setInitiative.tooltipKey}}" {{#unless commands.setInitiative.enabled}}disabled{{/unless}}></label><button type="button" class="osd-visibility {{#unless hidden}}revealed{{/unless}}" data-osd-command="combat.toggle-visibility" data-combat-uuid="{{../encounter.uuid}}" data-combatant-id="{{combatantId}}" data-busy-key="{{../encounter.uuid}}" {{#unless commands.toggleVisibility.enabled}}disabled{{/unless}} title="{{#if hidden}}{{localize 'OSD.Encounter.PlayerHidden'}}{{else}}{{localize 'OSD.Encounter.PlayerVisible'}}{{/if}}"><i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i></button><img src="{{img}}" alt=""><span class="osd-npc-name"><strong>{{name}}</strong><small>{{type}}</small></span><button type="button" class="osd-icon-button" data-osd-command="combat.roll-initiative" data-combat-uuid="{{../encounter.uuid}}" data-combatant-id="{{combatantId}}" data-busy-key="{{../encounter.uuid}}" {{#unless commands.rollInitiative.enabled}}disabled{{/unless}} title="{{localize 'OSD.Actions.RollInitiative'}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i></button><button type="button" class="osd-icon-button" data-osd-command="token.locate" data-token-uuid="{{tokenUuid}}" data-busy-key="{{tokenUuid}}" {{#unless commands.locate.enabled}}disabled{{/unless}} title="{{localize commands.locate.tooltipKey}}"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i></button></div>
                <div class="osd-npc-stats">
                  <label title="{{localize commands.setHp.tooltipKey}}" data-tooltip="{{commands.setHp.tooltipKey}}"><span>{{localize "OSD.Actor.CurrentHP"}}</span><input type="number" min="0" max="{{hp.effectiveMax}}" step="1" value="{{hp.value}}" data-osd-direct-command="actor.set-hp" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setHp.tooltipKey}}" data-tooltip="{{commands.setHp.tooltipKey}}" {{#unless commands.setHp.enabled}}disabled{{/unless}}></label>
                  <span><small>{{localize "OSD.Actor.BaseMax"}}</small><b>{{hp.baseMax}}</b></span>
                  <label title="{{localize commands.setMaxModifier.tooltipKey}}" data-tooltip="{{commands.setMaxModifier.tooltipKey}}"><span>{{localize "OSD.Actor.MaxModifier"}}</span><input class="osd-signed" type="text" inputmode="numeric" pattern="[+-]?[0-9]+" value="{{hp.maxModifierDisplay}}" data-osd-direct-command="actor.set-max-modifier" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setMaxModifier.tooltipKey}}" data-tooltip="{{commands.setMaxModifier.tooltipKey}}" {{#unless commands.setMaxModifier.enabled}}disabled{{/unless}}></label>
                  <span><small>{{localize "OSD.Actor.EffectiveMax"}}</small><b>{{hp.effectiveMax}}</b></span>
                  <label title="{{localize commands.setTempHp.tooltipKey}}" data-tooltip="{{commands.setTempHp.tooltipKey}}"><span>{{localize "OSD.Actor.TempHP"}}</span><input type="number" min="0" step="1" value="{{hp.temp}}" data-osd-direct-command="actor.set-temp-hp" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setTempHp.tooltipKey}}" data-tooltip="{{commands.setTempHp.tooltipKey}}" {{#unless commands.setTempHp.enabled}}disabled{{/unless}}></label>
                  <span><small>{{localize "OSD.Actor.AC"}}</small><b>{{ac}}</b></span>
                  <label title="{{localize commands.setAcModifier.tooltipKey}}" data-tooltip="{{commands.setAcModifier.tooltipKey}}"><span>{{localize "OSD.Actor.ACModifier"}}</span><input type="number" step="1" value="{{acModifier}}" data-osd-direct-command="actor.set-ac-modifier" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.setAcModifier.tooltipKey}}" data-tooltip="{{commands.setAcModifier.tooltipKey}}" {{#unless commands.setAcModifier.enabled}}disabled{{/unless}}></label>
                  <details class="osd-status-picker" data-osd-preserve-key="status:{{uuid}}"><summary>{{localize "OSD.Actions.Status"}} {{statuses.length}}</summary><div class="osd-status-menu">{{#each statusChoices}}<label><input type="checkbox" data-osd-status-choice data-target-uuid="{{../uuid}}" data-status-id="{{id}}" data-busy-key="{{../uuid}}" {{#if active}}checked{{/if}} {{#unless ../commands.toggleStatus.enabled}}disabled{{/unless}}><span>{{#if icon}}<img src="{{icon}}" alt="">{{/if}}{{label}}</span></label>{{/each}}</div></details>
                  <button type="button" class="{{#if concentrating}}active{{/if}}" data-osd-command="actor.toggle-concentration" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" {{#if concentrating}}data-confirm="{{localize 'OSD.Confirm.EndConcentration'}}"{{/if}} {{#unless commands.toggleConcentration.enabled}}disabled{{/unless}}>{{#if concentrating}}{{localize "OSD.Actions.EndConcentration"}}{{else}}{{localize "OSD.Actions.StartConcentration"}}{{/if}}</button>
                  {{#if death}}<div class="osd-death" data-osd-death-current-success="{{death.success}}" data-osd-death-current-failure="{{death.failure}}"><span>{{localize "OSD.Actor.DeathSaves"}}</span><span class="osd-pips osd-pips-success"><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="success" data-value="1" aria-label="1"></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="success" data-value="2" aria-label="2"></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="success" data-value="3" aria-label="3"></button></span><span class="osd-pips osd-pips-failure"><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="failure" data-value="1" aria-label="1"></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="failure" data-value="2" aria-label="2"></button><button type="button" data-osd-command="actor.set-death-save" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-field="failure" data-value="3" aria-label="3"></button></span></div>{{/if}}
                  {{#if characterControls}}<button type="button" data-osd-command="actor.toggle-inspiration" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" {{#unless commands.toggleInspiration.enabled}}disabled{{/unless}}>{{#if inspiration}}{{localize "OSD.Actions.RemoveInspiration"}}{{else}}{{localize "OSD.Actions.GainInspiration"}}{{/if}}</button><span class="osd-stepper"><span>{{localize "OSD.Actor.Exhaustion"}}</span><button type="button" data-osd-command="actor.adjust-exhaustion" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-delta="-1" {{#unless commands.exhaustionDown.enabled}}disabled{{/unless}} title="{{localize commands.exhaustionDown.tooltipKey}}">−</button><output>{{exhaustion}}</output><button type="button" data-osd-command="actor.adjust-exhaustion" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" data-delta="1" {{#unless commands.exhaustionUp.enabled}}disabled{{/unless}} title="{{localize commands.exhaustionUp.tooltipKey}}">+</button></span>{{/if}}
                  <button type="button" class="osd-icon-button" data-osd-command="actor.open-sheet" data-target-uuid="{{uuid}}" data-busy-key="{{uuid}}" title="{{localize commands.openSheet.tooltipKey}}" data-tooltip="{{commands.openSheet.tooltipKey}}" aria-label="{{localize commands.openSheet.tooltipKey}}" {{#unless commands.openSheet.enabled}}disabled{{/unless}}><i class="fa-solid fa-id-card" aria-hidden="true"></i></button>
                </div>
              </article>
            {{/if}}
          {{/each}}
        </div>
      {{else}}<div class="osd-empty"><i class="fa-solid fa-swords" aria-hidden="true"></i><p>{{localize "OSD.Encounter.Empty"}}</p></div>{{/if}}
    </section>
  </div>

  <dialog class="osd-layer" data-osd-layer="folder" hidden><header><h2>{{localize "OSD.Folder.Title"}}</h2><button type="button" class="osd-icon-button" data-osd-action="close-layer" aria-label="{{localize 'OSD.Actions.Close'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header><p>{{localize "OSD.Folder.Hint"}}</p><label><span>{{localize "OSD.Folder.ActorFolder"}}</span><select name="partyFolder" data-selected="{{partyFolder.selectedId}}"><option value="">{{localize "OSD.Folder.None"}}</option>{{#each partyFolder.options}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label class="osd-check"><input type="checkbox" name="includeDescendants" {{#if partyFolder.includeDescendants}}checked{{/if}}><span>{{localize "OSD.Folder.IncludeDescendants"}}</span></label><footer><button type="button" data-osd-action="save-folder">{{localize "OSD.Actions.Save"}}</button></footer></dialog>
  <dialog class="osd-layer osd-batch-layer" data-osd-layer="batch" hidden><header><h2>{{localize "OSD.Batch.Title"}}</h2><button type="button" class="osd-icon-button" data-osd-action="close-layer" aria-label="{{localize 'OSD.Actions.Close'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header><p>{{localize "OSD.Batch.Hint"}}</p><div class="osd-batch-toolbar"><button type="button" data-osd-action="batch-select-all">{{localize "OSD.Batch.SelectAll"}}</button><button type="button" data-osd-action="batch-clear-all">{{localize "OSD.Batch.ClearAll"}}</button></div><div class="osd-batch-actors">{{#each party}}<label><input type="checkbox" data-osd-batch-actor value="{{uuid}}" checked><img src="{{img}}" alt=""><span>{{name}}</span></label>{{/each}}</div><section><h3>{{localize "OSD.Batch.HP"}}</h3><label><span>{{localize "OSD.Actions.Amount"}}</span><input type="number" name="batchAmount" min="1" step="1" value="1"></label><button type="button" data-osd-action="batch-apply" data-batch-command="actor.damage" data-value-input="batchAmount">{{localize "OSD.Actions.Damage"}}</button><button type="button" data-osd-action="batch-apply" data-batch-command="actor.heal" data-value-input="batchAmount">{{localize "OSD.Actions.Heal"}}</button><label><span>{{localize "OSD.Actor.TempHP"}}</span><input type="number" name="batchTemp" min="0" step="1" value="0"></label><button type="button" data-osd-action="batch-apply" data-batch-command="actor.set-temp-hp" data-value-input="batchTemp">{{localize "OSD.Actions.SetTempHP"}}</button><label><span>{{localize "OSD.Actor.MaxModifier"}}</span><input type="number" name="batchMaxModifier" step="1" value="0"></label><button type="button" data-osd-action="batch-apply" data-batch-command="actor.set-max-modifier" data-value-input="batchMaxModifier">{{localize "OSD.Actions.SetMaxModifier"}}</button></section><section><h3>{{localize "OSD.Actor.Statuses"}}</h3><select name="batchStatus">{{#each statusOptions}}<option value="{{id}}">{{label}}</option>{{/each}}</select><button type="button" data-osd-action="batch-apply" data-batch-command="actor.set-status" data-active="true">{{localize "OSD.Batch.AddToAll"}}</button><button type="button" data-osd-action="batch-apply" data-batch-command="actor.set-status" data-active="false">{{localize "OSD.Batch.RemoveFromAll"}}</button></section></dialog>
  <dialog class="osd-layer" data-osd-layer="swap" hidden><header><h2>{{localize "OSD.Actions.SwapInitiative"}}</h2><button type="button" class="osd-icon-button" data-osd-action="close-layer" aria-label="{{localize 'OSD.Actions.Close'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header><label><span>A</span><select name="swapFirst">{{#each encounter.combatants}}<option value="{{combatantId}}">{{name}} · {{initiative}}</option>{{/each}}</select></label><label><span>B</span><select name="swapSecond">{{#each encounter.combatants}}<option value="{{combatantId}}">{{name}} · {{initiative}}</option>{{/each}}</select></label><footer><button type="button" data-osd-action="swap-initiative" data-combat-uuid="{{encounter.uuid}}">{{localize "OSD.Actions.SwapInitiative"}}</button></footer></dialog>
</section>
