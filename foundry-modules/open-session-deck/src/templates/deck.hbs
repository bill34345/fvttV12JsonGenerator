ction><section class="osd-operation-group"><h3><i class="fa-solid fa-sliders" aria-hidden="true"></i>{{localize "OSD.Ledger.More"}}</h3><details class="osd-operation-menu"><summary><i class="fa-solid fa-person-running" aria-hidden="true"></i>{{localize "OSD.Actor.ACModifier"}}<i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary><div class="osd-command-menu"><label>{{localize "OSD.Actor.ACModifier"}}<input type="number" value="0" data-osd-operation-input="ac"></label><button type="button" class="" data-osd-operation="actor.set-ac-modifier" disabled data-osd-label="{{localize 'OSD.Selection.Apply'}}" data-value-input="ac"><i class="fa-solid fa-check" aria-hidden="true"></i>{{localize "OSD.Selection.Apply"}} <small data-osd-eligible></small></button></div></details><details class="osd-operation-menu"><summary><i class="fa-solid fa-people-group" aria-hidden="true"></i>{{localize "OSD.Selection.MaxHpModifier"}}<i class="fa-solid fa-caret-down" aria-hidden="true"></i></summary><div class="osd-command-menu"><label>{{localize "OSD.Actions.SetMaxModifier"}}<input type="number" value="0" data-osd-operation-input="max"></label><button type="button" class="" data-osd-operation="actor.set-max-modifier" disabled data-osd-label="{{localize 'OSD.Selection.Apply'}}" data-value-input="max"><i class="fa-solid fa-check" aria-hidden="true"></i>{{localize "OSD.Selection.Apply"}} <small data-osd-eligible></small></button><label>{{localize "OSD.Actor.CurrentHP"}}<input type="number" min="0" value="0" data-osd-operation-input="hp"></label><button type="button" class="" data-osd-operation="actor.set-hp" disabled data-osd-label="{{localize 'OSD.Actions.SetHP'}}" data-value-input="hp"><i class="fa-solid fa-heart" aria-hidden="true"></i>{{localize "OSD.Actions.SetHP"}} <small data-osd-eligible></small></button></div></details><details class="osd-operation-menu"><summary><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>{{localize "OSD.Actor.DeathSaves"}}<i class="fa-solid fa-