r" min="0" step="1" value="0" data-osd-operation-input="temp" aria-label="{{localize 'OSD.Actor.TempHP'}}"><span class="osd-number-steppers"><button type="button" data-osd-step-input="temp" data-osd-step="1" aria-label="{{localize 'OSD.Actor.TempHP'}} +1"><i class="fa-solid fa-caret-up" aria-hidden="true"></i></button><button type="button" data-osd-step-input="temp" data-osd-step="-1" aria-label="{{localize 'OSD.Actor.TempHP'}} -1"><i class="fa-solid fa-caret-down" aria-hidden="true"></i></button></span></div></section>
