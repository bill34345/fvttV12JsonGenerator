<section class="battlefield-painter" aria-label="战场地形画笔">
  <header class="battlefield-painter__header">
    <p class="battlefield-painter__eyebrow">TACTICAL TERRAIN / P1 ALPHA</p>
    <h2>把战场画活</h2>
    <p>选择地形与阶段，然后在方格或六角格地图上按住拖动。</p>
  </header>

  <div class="battlefield-painter__terrains" role="list" aria-label="地形配置">
    {{#each terrains}}
      <button
        type="button"
        class="terrain-card {{#if selected}}is-selected{{/if}}"
        data-action="selectTerrain"
        data-terrain="{{id}}"
        style="--terrain-accent: {{accent}}"
        aria-pressed="{{selected}}"
      >
        <span class="terrain-card__art" style="background-image: url('{{preview}}')"></span>
        <span class="terrain-card__copy">
          <strong>{{shortLabel}}</strong>
          <small>{{description}}</small>
        </span>
      </button>
    {{/each}}
  </div>

  <div class="battlefield-painter__stages" aria-label="效果阶段">
    {{#each stages}}
      <button
        type="button"
        class="stage-button {{#if selected}}is-selected{{/if}}"
        data-action="selectStage"
        data-stage="{{index}}"
        aria-pressed="{{selected}}"
      >
        <span>阶段 {{#if index}}II{{else}}I{{/if}}</span>
        <strong>{{label}}</strong>
      </button>
    {{/each}}
  </div>

  <div class="battlefield-painter__modes" aria-label="画笔模式">
    <button type="button" class="mode-button {{#if isPaint}}is-selected{{/if}}" data-action="selectMode" data-mode="paint">
      <i class="fa-solid fa-paintbrush"></i><span>绘制</span>
    </button>
    <button type="button" class="mode-button {{#if isErase}}is-selected{{/if}}" data-action="selectMode" data-mode="erase">
      <i class="fa-solid fa-eraser"></i><span>擦除</span>
    </button>
    <button type="button" class="mode-button {{#if isAdvance}}is-selected{{/if}}" data-action="selectMode" data-mode="advance">
      <i class="fa-solid fa-forward-step"></i><span>切换阶段</span>
    </button>
  </div>

  {{#if state.p1Enabled}}
    <section class="battlefield-painter__brush" aria-label="笔刷几何">
      <div class="battlefield-painter__section-title">
        <span>笔刷几何</span>
        <small>半径 {{state.brushRadius}}</small>
      </div>
      <div class="battlefield-painter__shapes">
        <button type="button" class="shape-button {{#if isFree}}is-selected{{/if}}" data-action="selectBrushShape" data-shape="free" aria-pressed="{{isFree}}">
          <i class="fa-solid fa-paintbrush"></i><span>自由</span>
        </button>
        <button type="button" class="shape-button {{#if isLine}}is-selected{{/if}}" data-action="selectBrushShape" data-shape="line" aria-pressed="{{isLine}}">
          <i class="fa-solid fa-slash"></i><span>直线</span>
        </button>
        <button type="button" class="shape-button {{#if isFill}}is-selected{{/if}}" data-action="selectBrushShape" data-shape="fill" aria-pressed="{{isFill}}" title="拖拽填充起点与终点之间的格位区域">
          <i class="fa-solid fa-vector-square"></i><span>填充</span>
        </button>
      </div>
      <div class="battlefield-painter__radius" aria-label="笔刷半径">
        {{#each radii}}
          <button type="button" class="radius-button {{#if selected}}is-selected{{/if}}" data-action="setBrushRadius" data-radius="{{value}}" aria-label="半径 {{value}}" aria-pressed="{{selected}}">{{value}}</button>
        {{/each}}
      </div>
      <div class="battlefield-painter__history" aria-label="操作历史">
        <button type="button" data-action="undo" {{#unless state.canUndo}}disabled{{/unless}}>
          <i class="fa-solid fa-rotate-left"></i><span>撤销</span>
        </button>
        <button type="button" data-action="redo" {{#unless state.canRedo}}disabled{{/unless}}>
          <i class="fa-solid fa-rotate-right"></i><span>重做</span>
        </button>
      </div>
    </section>
  {{/if}}

  <footer class="battlefield-painter__footer">
    <p class="battlefield-painter__status" aria-live="polite">{{state.status}}</p>
    <button type="button" class="activate-button {{#if state.active}}is-active{{/if}}" data-action="togglePainter">
      <i class="fa-solid {{#if state.active}}fa-stop{{else}}fa-crosshairs{{/if}}"></i>
      {{#if state.active}}停用画笔{{else}}启用画笔{{/if}}
    </button>
  </footer>
</section>
