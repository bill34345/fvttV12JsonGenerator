--- a/monks-combat-details.js
+++ b/monks-combat-details.js
@@ -574,6 +574,35 @@
 
 Hooks.once('init', MonksCombatDetails.init);
 Hooks.on("ready", MonksCombatDetails.ready);
+Hooks.once("ready", () => {
+	const chat = ui.chat;
+	if (typeof chat?.notify !== "function" || typeof chat._shouldShowNotifications !== "function") return;
+	const notify = chat.notify;
+	const pending = [];
+	let timer = null;
+	const next = () => {
+		const job = pending.shift();
+		if (!job) {
+			timer = null;
+			return;
+		}
+		timer = setTimeout(next, 0);
+		const [receiver, message, options] = job;
+		notify.call(receiver, message, options);
+	};
+	chat.notify = function (message, options) {
+		if (!options?.newMessage || !message.getFlag("core", "initiativeRoll") || !this._shouldShowNotifications()) {
+			return notify.call(this, message, options);
+		}
+		// Keep the first notice immediate and yield between the remaining layout updates.
+		if (timer !== null) {
+			pending.push([this, message, options]);
+			return;
+		}
+		timer = setTimeout(next, 0);
+		return notify.call(this, message, options);
+	};
+});
 Hooks.once('setup', () => {
 	game.settings.settings.get("monks-combat-details.nextup-message").default = i18n("MonksCombatDetails.Next");
 	game.settings.settings.get("monks-combat-details.turn-message").default = i18n("MonksCombatDetails.Turn");
